---
import { NAV_ITEMS, SITE } from '@lib/site';
import MobileNav from '@components/MobileNav.astro';

const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="sticky top-0 z-40 border-b border-transparent bg-paper/90 backdrop-blur-sm transition-colors duration-(--duration-fast) data-[elevated]:border-ink-100"
>
  <div class="mx-auto flex max-w-(--container-wide) items-center justify-between px-6 py-5 sm:px-8">
    <a href="/" class="font-display text-lg tracking-wide text-ink-950">
      {SITE.brandName}
    </a>

    <nav aria-label="Primary" class="hidden items-center gap-9 md:flex">
      <ul class="flex items-center gap-9">
        {NAV_ITEMS.map((item) => (
          <li>
            <a
              href={item.href}
              aria-current={isActive(item.href) ? 'page' : undefined}
              class="relative py-1 text-sm text-ink-700 transition-colors duration-(--duration-fast) hover:text-ink-950 aria-[current=page]:text-ink-950 after:absolute after:inset-x-0 after:-bottom-0.5 after:h-px after:origin-left after:scale-x-0 after:bg-accent after:transition-transform after:duration-(--duration-fast) hover:after:scale-x-100 aria-[current=page]:after:scale-x-100"
            >
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <a
        href="/contact"
        class="border border-ink-950 px-4 py-1.5 text-sm text-ink-950 transition-colors duration-(--duration-fast) hover:border-accent hover:bg-accent hover:text-paper"
      >
        Let's talk
      </a>
    </nav>

    <MobileNav />
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  if (header) {
    const setElevated = () => {
      const elevated = window.scrollY > 8;
      header.toggleAttribute('data-elevated', elevated);
    };
    setElevated();
    window.addEventListener('scroll', setElevated, { passive: true });
  }
</script>
