---
/**
 * One archive row — the "rest" list on /contents/articles reuses this
 * instead of repeating the same markup inline, so a future change to how
 * an article row looks happens in one place.
 */
import type { CollectionEntry } from 'astro:content';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import { readingTime } from '@lib/reading-time';

interface Props {
  article: CollectionEntry<'articles'>;
}

const { article } = Astro.props;
const { title, description, publishDate, category, placeholder } = article.data;
const href = article.data.externalUrl ?? `/contents/articles/${article.id}`;
const formattedDate = publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<a href={href} class="group/row block py-6 transition-colors">
  <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] tracking-wide text-meta uppercase">
    <time datetime={publishDate.toISOString()}>{formattedDate}</time>
    <span>{readingTime(article.body ?? '')}</span>
    <span>{category}</span>
    {placeholder && <PlaceholderTag />}
  </div>
  <h3 class="mt-2 font-display text-xl font-bold tracking-[-0.02em] text-ink transition-colors group-hover/row:text-accent-ink">
    {title}
  </h3>
  <p class="mt-1.5 max-w-2xl font-body text-base text-body">{description}</p>
</a>
