---
/**
 * CV-stated marketing results. Deliberately visually and textually
 * separated from the Selected Systems section — see RESULTS in site.ts
 * and content-status.md for why these aren't attributed to that work.
 */
import Section from '@components/Section.astro';
import { RESULTS, HOME } from '@lib/site';
---

<Section kicker={HOME.results.kicker} heading={HOME.results.heading} tone="dim" reveal>
  <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
    {RESULTS.map((result) => (
      <div class="border-t-2 border-accent pt-5">
        <p class="font-display text-4xl text-ink-950 sm:text-5xl">{result.metric}</p>
        <p class="mt-3 text-sm text-ink-700">{result.detail}</p>
        <p class="mt-3 text-xs tracking-wide text-ink-500 uppercase">{result.source}</p>
      </div>
    ))}
  </div>
  <p class="mt-10 max-w-2xl text-xs text-ink-500 italic">{HOME.results.note}</p>
</Section>
