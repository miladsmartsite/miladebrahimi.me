---
/**
 * CV-stated marketing results, now with a lightweight proportional bar
 * per metric (width derived directly from the stated percentage — no
 * invented scale or additional numbers). Deliberately visually and
 * textually separated from Selected Systems — see RESULTS in site.ts and
 * content-status.md for why these aren't attributed to that work.
 */
import Section from '@components/Section.astro';
import { RESULTS, HOME } from '@lib/site';

const withBar = RESULTS.map((result) => ({
  ...result,
  // Extract the numeric value from a string like "+30%" for the bar width.
  // Falls back to 0 (no bar) if a future entry isn't a plain percentage.
  percent: Number(result.metric.replace(/[^0-9.]/g, '')) || 0,
}));
const maxPercent = Math.max(...withBar.map((r) => r.percent), 1);
---

<Section kicker={HOME.results.kicker} heading={HOME.results.heading} tone="dim" reveal>
  <div class="grid gap-12 sm:grid-cols-3 sm:gap-10">
    {withBar.map((result, i) => (
      <div class:list={['sm:pl-10', i > 0 && 'sm:border-l sm:border-line']}>
        <p class="font-display text-7xl leading-none font-extrabold tracking-[-0.03em] text-ink tabular-nums sm:text-8xl">
          {result.metric}
        </p>
        <span
          class="brass-rule mt-6 block h-[3px]"
          style={`width: ${Math.max(Math.round((result.percent / maxPercent) * 100), 12)}%`}
        ></span>
        <p class="mt-5 font-body text-base text-body">{result.detail}</p>
        <p class="mt-3 font-mono text-[10px] tracking-wide text-meta uppercase">{result.source}</p>
      </div>
    ))}
  </div>
  <p class="mt-12 max-w-2xl font-body text-sm text-meta italic">{HOME.results.note}</p>
</Section>
