---
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import { HOME } from '@lib/site';

interface Props {
  number?: string;
}

const { number } = Astro.props;
---

<Section number={number} kicker="Next Conversation" tone="navy" field reveal class="!py-24 lg:!py-32">
  <div class="flex flex-col items-start gap-8 sm:flex-row sm:items-end sm:justify-between">
    <h2 class="max-w-xl font-display text-4xl leading-[1.06] font-bold tracking-[-0.03em] text-paper text-balance uppercase sm:text-5xl">
      {HOME.finalCta.heading}
    </h2>
    <div class="flex flex-col items-start gap-4">
      <p class="font-body text-lg text-on-dark-muted">{HOME.finalCta.body}</p>
      <div class="flex flex-wrap items-center gap-4">
        <Button href="/contact" variant="accent" arrow data-cta="final-cta-contact">{HOME.finalCta.primaryCta}</Button>
        <Button
          href="/resume"
          variant="secondary"
          class="!border-on-dark-line !text-paper hover:!border-accent hover:!text-accent"
          data-cta="final-cta-resume"
        >
          {HOME.finalCta.secondaryCta}
        </Button>
      </div>
    </div>
  </div>
</Section>
