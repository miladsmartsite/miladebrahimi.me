---
/**
 * Editorial intro/positioning section — the homepage's first "visual
 * break": an immersive navy surface with a subtle full-bleed grid field
 * behind an oversized statement, asymmetrically offset by a shorter
 * supporting paragraph. No cards, no icons — typography and the field
 * texture carry it.
 */
import Section from '@components/Section.astro';

interface Props {
  kicker: string;
  statement: string;
  body: string;
}

const { kicker, statement, body } = Astro.props;
---

<Section kicker={kicker} tone="navy" field reveal>
  <div class="grid gap-8 lg:grid-cols-12 lg:gap-8">
    <p class="font-display text-3xl leading-[1.15] font-bold tracking-[-0.03em] text-paper text-balance sm:text-4xl lg:col-span-8 lg:text-[2.75rem]">
      {statement}
    </p>
    <p class="font-body text-base leading-relaxed text-on-dark-muted lg:col-span-4 lg:col-start-9 lg:self-end">
      {body}
    </p>
  </div>
</Section>
