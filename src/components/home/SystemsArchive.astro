---
/**
 * "Selected Work" as a system register — an archive, not cards: index
 * numeral / title+description+register metadata (PURPOSE / TYPE /
 * STATUS, always visible) / conceptual visual, where hovering or
 * focusing a row turns its number gold, illuminates its visual (via
 * SystemPreview's currentColor), and reveals a deeper problem/evidence
 * panel plus the domain-tick row. Pure CSS (:has(), no JS). On mobile
 * every row's detail is open by default since there's no hover.
 */
import Section from '@components/Section.astro';
import SystemPreview from '@components/SystemPreview.astro';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import StatusTag from '@components/StatusTag.astro';
import MetaRow from '@components/MetaRow.astro';
import { DOMAIN_CODES, HOME, SYSTEM_TYPE_LABELS } from '@lib/site';
import type { CollectionEntry } from 'astro:content';

interface Props {
  systems: CollectionEntry<'projects'>[];
  number?: string;
}

const { systems, number } = Astro.props;

// Per-entry :has() rules — generated once at build time. Hand-rolled CSS
// for five systems is simpler and more robust than a client script.
const activeCss = systems
  .map(
    (project, i) => `
    .systems-archive:has(#sys-${i}:hover) .sys-numeral-${i},
    .systems-archive:has(#sys-${i}:focus-within) .sys-numeral-${i} {
      color: var(--color-accent);
    }
    .systems-archive:has(#sys-${i}:hover) #sys-${i} .sys-underline,
    .systems-archive:has(#sys-${i}:focus-within) #sys-${i} .sys-underline {
      transform: scaleX(1);
    }
    .systems-archive:has(#sys-${i}:hover) #sys-${i} .sys-preview,
    .systems-archive:has(#sys-${i}:focus-within) #sys-${i} .sys-preview {
      color: var(--color-accent);
      opacity: 1;
    }
    @media (min-width: 1024px) {
      .systems-archive:has(#sys-${i}:hover) #sys-${i} .sys-detail,
      .systems-archive:has(#sys-${i}:focus-within) #sys-${i} .sys-detail {
        grid-template-rows: 1fr;
        opacity: 1;
        margin-top: 1.5rem;
      }
    }
  `,
  )
  .join('\n');
---

<Section number={number} kicker={HOME.selectedWork.kicker} heading={HOME.selectedWork.heading} tone="paper" width="wide" reveal>
  <p class="mb-8 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">System Register</p>
  <div class="systems-archive">
    {systems.map((project, index) => {
      const { title, summary, context, problem, outcome, evidenceNote, tools, tags, role, client, year, placeholder, redacted, previewType } =
        project.data;
      const href = project.data.externalUrl ?? `/projects/${project.id}`;
      const result = outcome ?? evidenceNote;
      const purpose = context ?? summary;
      const typeLabel = SYSTEM_TYPE_LABELS[previewType ?? 'dashboard'];
      return (
        <a
          id={`sys-${index}`}
          href={href}
          class="group/card block scroll-mt-28 border-b border-line py-10 transition-colors first:border-t sm:py-12"
        >
          <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">
            <div class="lg:col-span-1">
              <span class={`sys-numeral-${index} font-display text-4xl leading-none font-bold text-line transition-colors duration-(--duration-fast) lg:text-5xl`}>
                {String(index + 1).padStart(2, '0')}
              </span>
            </div>

            <div class="lg:col-span-7">
              <div class="flex flex-wrap items-center gap-3">
                <h3 class="relative inline-block font-display text-2xl leading-tight font-bold tracking-[-0.02em] text-ink sm:text-[1.75rem]">
                  {title}
                  <span class="sys-underline absolute inset-x-0 -bottom-1 h-px origin-left scale-x-0 bg-accent transition-transform duration-(--duration-base)" aria-hidden="true"></span>
                </h3>
                {placeholder && <PlaceholderTag />}
              </div>

              <MetaRow
                items={[client, year && `${year}${redacted ? ' · Redacted' : ''}`, role && `Role: ${role}`]}
                class="mt-2 transition-colors duration-(--duration-fast) group-hover/card:text-body"
              />

              <dl class="mt-5 grid grid-cols-2 gap-x-6 gap-y-3 border-t border-line pt-5 sm:grid-cols-3">
                <div class="col-span-2 sm:col-span-1">
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-accent-ink uppercase">Purpose</dt>
                  <dd class="mt-1 font-body text-sm text-body">{purpose}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-accent-ink uppercase">Type</dt>
                  <dd class="mt-1 font-body text-sm text-body">{typeLabel}</dd>
                </div>
                <div>
                  <dt class="font-mono text-[10px] tracking-[0.14em] text-accent-ink uppercase">Status</dt>
                  <dd class="mt-1"><StatusTag status="built" /></dd>
                </div>
              </dl>

              <div class="mt-5 flex items-center gap-1.5" aria-hidden="true">
                {DOMAIN_CODES.map((domain) => (
                  <span
                    class:list={[
                      'flex h-4 items-center border px-1.5 font-mono text-[10px] font-medium tracking-wide',
                      tags.includes(domain.tag)
                        ? 'border-accent bg-accent-tint text-accent-ink'
                        : 'border-line text-line',
                    ]}
                  >
                    {domain.code}
                  </span>
                ))}
              </div>

              <div class="mt-5 max-w-[11rem] lg:hidden">
                <SystemPreview type={previewType ?? 'dashboard'} class="opacity-70" />
              </div>

              {/* Collapsed by default at lg+ (revealed on hover/focus via
                  generated CSS above); always open below lg, since touch
                  has no hover. */}
              <div class="sys-detail mt-6 grid grid-rows-[1fr] opacity-100 transition-all duration-(--duration-base) lg:mt-0 lg:grid-rows-[0fr] lg:opacity-0">
                <div class="overflow-hidden">
                  <div class="grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
                    {problem && (
                      <div>
                        <p class="font-mono text-[11px] font-bold tracking-wide text-accent-ink uppercase">Problem</p>
                        <p class="mt-1.5 font-body text-base text-body">{problem}</p>
                      </div>
                    )}
                    <div>
                      <p class="font-mono text-[11px] font-bold tracking-wide text-accent-ink uppercase">
                        {outcome ? 'Result' : 'Evidence'}
                      </p>
                      <p class="mt-1.5 font-body text-base text-body">{result}</p>
                    </div>
                  </div>
                  {tools.length > 0 && (
                    <ul class="mt-4 flex flex-wrap gap-2">
                      {tools.map((tool) => (
                        <li class="border border-line px-2.5 py-1 font-mono text-[10px] tracking-wide text-body uppercase">
                          {tool}
                        </li>
                      ))}
                    </ul>
                  )}
                </div>
              </div>

              <span class="mt-6 inline-flex items-center gap-1.5 border-b border-ink pb-0.5 font-mono text-[13px] font-medium text-ink transition-colors group-hover/card:border-accent group-hover/card:text-accent-ink">
                [ VIEW SYSTEM ]
                <span class="transition-transform duration-(--duration-fast) group-hover/card:translate-x-1">→</span>
              </span>
            </div>

            <div class="hidden items-center lg:col-span-4 lg:flex">
              <SystemPreview type={previewType ?? 'dashboard'} class="sys-preview opacity-65" />
            </div>
          </div>
        </a>
      );
    })}
  </div>

  <p class="mt-8 max-w-2xl font-body text-sm text-meta">{HOME.selectedWork.note}</p>
</Section>

<style set:html={activeCss}></style>
