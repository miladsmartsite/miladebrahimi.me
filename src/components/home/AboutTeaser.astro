---
/**
 * The homepage's "real human presence" moment — portrait on the left,
 * narrative on the right, per the brief's explicit About-section layout.
 */
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import Portrait from '@components/Portrait.astro';
import { HOME, SITE } from '@lib/site';
---

<Section tone="paper" reveal>
  <div class="grid gap-10 lg:grid-cols-12 lg:items-center lg:gap-12">
    <div class="lg:col-span-3">
      <Portrait class="max-w-56" />
    </div>
    <div class="lg:col-span-9 lg:border-l lg:border-line lg:pl-12">
      <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">
        {HOME.about.kicker}
      </p>
      <p class="mt-4 max-w-2xl font-display text-2xl leading-snug font-bold tracking-[-0.02em] text-ink text-balance sm:text-3xl">
        {HOME.about.body}
      </p>
      <div class="mt-6 flex flex-wrap items-center gap-4">
        <Button href="/about" variant="ghost" arrow class="-ml-5">
          {HOME.about.cta.replace(' →', '')}
        </Button>
        <Button href={SITE.cvUrl} variant="secondary" external>Download CV</Button>
      </div>
    </div>
  </div>
</Section>
