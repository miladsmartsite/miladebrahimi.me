---
/**
 * Homepage preview of the "Contents" hub (/contents) — an honest status
 * row per category, computed from the real content collections rather
 * than hard-coded. Articles/Books show real counts; Podcasts/Videos have
 * no collection yet, so they say so plainly ("Currently Building") rather
 * than pretending.
 */
import { getCollection } from 'astro:content';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import { HOME } from '@lib/site';

interface Props {
  number?: string;
}

const { number } = Astro.props;

const articles = await getCollection('articles', ({ data }) => !data.draft);
const publishedArticles = articles
  .filter((a) => !a.data.placeholder)
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const latestArticle = publishedArticles[0];
const books = await getCollection('books', ({ data }) => !data.draft);

const categories = [
  {
    label: 'Articles',
    // Once a real (non-placeholder) article exists, link straight to it and
    // show its title as the status — this row updates on its own the
    // moment a new article is published, with no component edit required.
    href: latestArticle ? `/contents/articles/${latestArticle.id}` : '/contents/articles',
    status: latestArticle ? `Latest: ${latestArticle.data.title}` : 'Currently Building',
  },
  { label: 'Books', href: '/contents/books', status: `${books.length} published` },
  { label: 'Podcasts', href: '/contents/podcasts', status: 'Currently Building' },
  { label: 'Videos', href: '/contents/videos', status: 'Currently Building' },
  { label: 'More', href: '/contents/more', status: 'Talks & resources' },
];
---

<Section number={number} kicker={HOME.contentsPreview.kicker} heading={HOME.contentsPreview.heading} tone="paper" width="wide" reveal>
  <p class="mb-5 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Content System</p>
  <ol class="border-t border-line">
    {categories.map((cat, i) => (
      <li class="group border-b border-line transition-colors hover:bg-paper-dim">
        <a href={cat.href} class="flex min-h-16 items-center justify-between gap-6 py-6">
          <span class="flex items-center gap-6">
            <span class="font-mono text-[11px] text-meta tabular-nums sm:w-10">{String(i + 1).padStart(2, '0')}</span>
            <span class="font-display text-2xl font-bold tracking-[-0.02em] text-ink transition-colors group-hover:text-accent-ink sm:text-3xl">
              {cat.label}
            </span>
          </span>
          <span class="max-w-[9rem] truncate font-mono text-[10px] tracking-wide text-meta uppercase sm:max-w-xs">{cat.status}</span>
        </a>
      </li>
    ))}
  </ol>
  <div class="mt-10">
    <Button href="/contents" variant="secondary" arrow data-cta="contents-explore">{HOME.contentsPreview.cta}</Button>
  </div>
</Section>
