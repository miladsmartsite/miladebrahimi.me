---
/**
 * Books, presented as typographic "plates" rather than fake cover images —
 * deliberately avoiding stock/AI-generated imagery when no real covers
 * exist yet.
 */
import type { CollectionEntry } from 'astro:content';
import Section from '@components/Section.astro';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import { HOME } from '@lib/site';

interface Props {
  books: CollectionEntry<'books'>[];
}

const { books } = Astro.props;
---

<Section kicker={HOME.books.kicker} heading={HOME.books.heading} tone="paper" reveal>
  <div class="grid gap-6 sm:grid-cols-2 lg:grid-cols-3">
    {books.map((book) => (
      <div class="group relative flex min-h-64 flex-col justify-between border border-ink-300 p-7 transition-colors hover:border-accent">
        <span class="absolute inset-y-0 left-0 w-1.5 bg-ink-300 transition-colors group-hover:bg-accent" aria-hidden="true"></span>
        <div>
          <div class="flex flex-wrap items-center gap-2">
            {book.data.year && <span class="text-xs text-ink-500">{book.data.year}</span>}
            {book.data.language && (
              <span class="text-xs tracking-wide text-ink-500 uppercase">· {book.data.language}</span>
            )}
            {book.data.placeholder && <PlaceholderTag />}
          </div>
          <h3 class="mt-3 font-display text-2xl text-ink-950">{book.data.title}</h3>
          {book.data.subtitle && <p class="mt-1 text-sm text-ink-500 italic">{book.data.subtitle}</p>}
        </div>
        <p class="mt-4 text-sm text-ink-700">{book.data.description}</p>
      </div>
    ))}
  </div>
</Section>
