---
/**
 * "Areas of Practice" as an editorial indexed list rather than service
 * cards — numbered rows, a standing label (Practice/Experience/Focus) so
 * nothing overclaims, description revealed on hover on pointer devices
 * (always visible on touch since there's no hover there).
 */
import Section from '@components/Section.astro';
import { PRACTICE_AREAS, HOME } from '@lib/site';

const total = String(PRACTICE_AREAS.length).padStart(2, '0');
---

<Section kicker={HOME.areas.kicker} heading={HOME.areas.heading} tone="dim" reveal>
  <ol class="border-t border-line">
    {PRACTICE_AREAS.map((area, i) => (
      <li class="group border-b border-line py-6 transition-colors sm:py-7">
        <div class="flex flex-col gap-2 sm:flex-row sm:items-baseline sm:gap-6">
          <span class="flex items-center gap-2 font-mono text-[11px] text-meta tabular-nums sm:w-16 sm:shrink-0">
            <span class="size-1.5 shrink-0 rounded-full bg-line transition-colors group-hover:bg-accent" aria-hidden="true"></span>
            {String(i + 1).padStart(2, '0')} / {total}
          </span>
          <h3 class="font-display text-2xl font-bold tracking-[-0.02em] text-ink transition-colors sm:text-3xl sm:group-hover:text-accent-ink">
            {area.title}
          </h3>
          <span class="font-mono text-[10px] font-bold tracking-[0.1em] text-accent-ink uppercase sm:ml-auto">
            {area.standing}
          </span>
        </div>
        <p class="mt-2 max-w-2xl font-body text-base text-body sm:ml-22 sm:mt-0 sm:max-h-0 sm:overflow-hidden sm:opacity-0 sm:transition-all sm:duration-(--duration-base) sm:group-hover:mt-2 sm:group-hover:max-h-20 sm:group-hover:opacity-100">
          {area.description}
        </p>
      </li>
    ))}
  </ol>
</Section>
