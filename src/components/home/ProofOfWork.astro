---
/**
 * "Proof of Work" — an executive scoreboard, not KPI cards: the stat trio
 * renders as one bordered grid (both horizontal and vertical rules, like
 * a real scoreboard/table), followed by the three CV-stated percentage
 * results in the same large-number treatment as before. A single,
 * prominent clarification line makes explicit that the percentages are
 * reported career results, not claimed outcomes of the five systems shown
 * above — see RESULTS/PROOF_STATS in site.ts and content-status.md.
 */
import Section from '@components/Section.astro';
import { PROOF_STATS, RESULTS, HOME } from '@lib/site';

interface Props {
  number?: string;
}

const { number } = Astro.props;

const withBar = RESULTS.map((result) => ({
  ...result,
  percent: Number(result.metric.replace(/[^0-9.]/g, '')) || 0,
}));
const maxPercent = Math.max(...withBar.map((r) => r.percent), 1);
---

<Section number={number} kicker={HOME.proof.kicker} heading={HOME.proof.heading} tone="dim" reveal>
  <p class="mb-5 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Scoreboard</p>
  <dl class="grid grid-cols-3 divide-x divide-line border border-line">
    {PROOF_STATS.map((stat) => (
      <div class="px-4 py-6 sm:px-8 sm:py-8">
        <dd class="font-display text-4xl font-extrabold tracking-[-0.02em] text-ink tabular-nums sm:text-5xl">
          {stat.value}
        </dd>
        <dt class="mt-2 font-mono text-[10px] tracking-[0.1em] text-meta uppercase">{stat.label}</dt>
      </div>
    ))}
  </dl>

  <p class="mt-14 mb-5 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Career Results</p>
  <div class="grid gap-12 lg:grid-cols-3 lg:gap-10">
    {withBar.map((result, i) => (
      <div class:list={['lg:pl-10', i > 0 && 'lg:border-l lg:border-line']}>
        <p class="font-display text-6xl leading-none font-extrabold tracking-[-0.03em] text-ink tabular-nums sm:text-7xl">
          {result.metric}
        </p>
        <span
          class="brass-rule mt-5 block h-[3px]"
          style={`width: ${Math.max(Math.round((result.percent / maxPercent) * 100), 12)}%`}
        ></span>
        <p class="mt-5 font-body text-base text-body">{result.detail}</p>
        <p class="mt-3 font-mono text-[10px] tracking-wide text-meta uppercase">Source: {result.source}</p>
      </div>
    ))}
  </div>

  <p class="mt-12 max-w-2xl border-t border-line pt-6 font-body text-sm text-meta italic">{HOME.proof.note}</p>
</Section>
