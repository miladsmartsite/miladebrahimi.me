---
/**
 * "Proof of Work" — the homepage's evidence section. Two tiers: a small
 * stat trio (years/systems/books — structural facts, not outcomes) above
 * the three CV-stated percentage results (the same visual treatment as
 * the former standalone Results section). A single, prominent
 * clarification line makes explicit that the percentages are reported
 * career results, not claimed outcomes of the five systems shown above —
 * see RESULTS/PROOF_STATS in site.ts and content-status.md.
 */
import Section from '@components/Section.astro';
import { PROOF_STATS, RESULTS, HOME } from '@lib/site';

const withBar = RESULTS.map((result) => ({
  ...result,
  percent: Number(result.metric.replace(/[^0-9.]/g, '')) || 0,
}));
const maxPercent = Math.max(...withBar.map((r) => r.percent), 1);
---

<Section kicker={HOME.proof.kicker} heading={HOME.proof.heading} tone="dim" reveal>
  <dl class="grid grid-cols-3 gap-6 border-b border-line pb-10 sm:gap-10">
    {PROOF_STATS.map((stat) => (
      <div>
        <dd class="font-display text-4xl font-extrabold tracking-[-0.02em] text-ink tabular-nums sm:text-5xl">
          {stat.value}
        </dd>
        <dt class="mt-2 font-mono text-[10px] tracking-[0.1em] text-meta uppercase">{stat.label}</dt>
      </div>
    ))}
  </dl>

  <div class="mt-12 grid gap-12 lg:grid-cols-3 lg:gap-10">
    {withBar.map((result, i) => (
      <div class:list={['lg:pl-10', i > 0 && 'lg:border-l lg:border-line']}>
        <p class="font-display text-6xl leading-none font-extrabold tracking-[-0.03em] text-ink tabular-nums sm:text-7xl">
          {result.metric}
        </p>
        <span
          class="brass-rule mt-5 block h-[3px]"
          style={`width: ${Math.max(Math.round((result.percent / maxPercent) * 100), 12)}%`}
        ></span>
        <p class="mt-5 font-body text-base text-body">{result.detail}</p>
        <p class="mt-3 font-mono text-[10px] tracking-wide text-meta uppercase">{result.source}</p>
      </div>
    ))}
  </div>

  <p class="mt-12 max-w-2xl border-t border-line pt-6 font-body text-sm text-meta italic">{HOME.proof.note}</p>
</Section>
