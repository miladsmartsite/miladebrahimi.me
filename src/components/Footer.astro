---
/**
 * The site's one consistent closing frame — identical on every page.
 * Carries the ME monogram (the recurring brand mark), primary nav, and
 * the three real contact channels (LinkedIn, email, CV).
 */
import { SITE, NAV_ITEMS } from '@lib/site';
import SocialLinks from '@components/SocialLinks.astro';
import Wordmark from '@components/Wordmark.astro';

const year = new Date().getFullYear();
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-(--container-wide) px-6 py-16 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a href="/" aria-label="Home">
          <Wordmark size="large" reversed />
        </a>
        <p class="mt-4 max-w-xs font-body text-sm text-on-dark-muted">Systems · Operations · Strategy · Ideas</p>
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-10 gap-y-2 sm:flex sm:flex-wrap sm:gap-8">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} class="font-body text-[17px] text-on-dark-muted transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div>
        <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent uppercase">Get in touch</p>
        <ul class="mt-3 flex flex-col gap-2 font-body text-[17px]">
          <li>
            <a href={`mailto:${SITE.contactEmail}`} class="text-on-dark-muted transition-colors hover:text-accent">
              {SITE.contactEmail}
            </a>
          </li>
          <li>
            <a
              href={SITE.cvUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="text-on-dark-muted transition-colors hover:text-accent"
            >
              Download CV
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-12 flex flex-col-reverse items-start gap-4 border-t border-on-dark-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[11px] tracking-wide text-on-dark-muted">&copy; {year} {SITE.name}. All rights reserved.</p>
      <SocialLinks dark />
    </div>
  </div>
</footer>
