---
/**
 * Phase 6 footer — a closing register, not a card wall. One oversized
 * wordmark block carrying the real positioning statement, then three
 * plain link columns (Explore / Contents / Connect) on a dark Harbour
 * surface. Connect lists only the two real channels that exist —
 * LinkedIn and email — no invented social accounts.
 */
import { SITE, NAV_ITEMS, MEGA_MENUS } from '@lib/site';
import Wordmark from '@components/Wordmark.astro';

const year = new Date().getFullYear();
const exploreLinks = NAV_ITEMS.filter((item) => item.label !== 'Contents');
const contentsLinks = MEGA_MENUS.Contents.groups[0].links;
---

<footer class="bg-ink text-paper">
  <div class="mx-auto max-w-(--container-wide) px-6 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <a href="/" aria-label="Home" class="inline-flex">
          <Wordmark size="large" reversed />
        </a>
        <p class="mt-6 max-w-sm font-display text-xl leading-snug font-semibold tracking-[-0.01em] text-paper">
          {SITE.positioning}
        </p>
        <p class="mt-3 font-mono text-[11px] tracking-[0.14em] text-on-dark-muted uppercase">
          Systems · Operations · Strategy · Ideas
        </p>
      </div>

      <nav aria-label="Explore" class="lg:col-span-2">
        <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent uppercase">Explore</p>
        <ul class="mt-4 flex flex-col">
          {exploreLinks.map((item) => (
            <li>
              <a href={item.href} class="flex min-h-11 items-center font-body text-base text-on-dark-muted transition-colors hover:text-accent">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <nav aria-label="Contents" class="lg:col-span-2">
        <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent uppercase">Contents</p>
        <ul class="mt-4 flex flex-col">
          {contentsLinks.map((link) => (
            <li>
              <a href={link.href} class="flex min-h-11 items-center font-body text-base text-on-dark-muted transition-colors hover:text-accent">
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-3">
        <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent uppercase">Connect</p>
        <ul class="mt-4 flex flex-col font-body text-base">
          <li>
            <a href={`mailto:${SITE.contactEmail}`} data-cta="footer-email" class="flex min-h-11 items-center text-on-dark-muted transition-colors hover:text-accent">
              {SITE.contactEmail}
            </a>
          </li>
          <li>
            <a
              href="https://www.linkedin.com/in/miladebrahimi-me"
              target="_blank"
              rel="noopener noreferrer"
              data-cta="footer-linkedin"
              class="flex min-h-11 items-center text-on-dark-muted transition-colors hover:text-accent"
            >
              LinkedIn
            </a>
          </li>
        </ul>
      </div>
    </div>

    <div class="mt-14 flex flex-col-reverse items-start gap-2 border-t border-on-dark-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-[11px] tracking-wide text-on-dark-muted">&copy; {year} {SITE.name}. All rights reserved.</p>
      <p class="font-mono text-[11px] tracking-wide text-on-dark-muted">Built with intention.</p>
    </div>
  </div>
</footer>
