---
/**
 * Footer: the large wordmark and tagline, the free-worksheet invitation,
 * and three short link columns. Only real channels are listed.
 */
import Wordmark from '@components/Wordmark.astro';
import Button from '@components/Button.astro';
import { SITE, NAV_ITEMS, SOCIAL_LINKS, YOUTUBE } from '@lib/site';

const year = new Date().getFullYear();
const more = [
  { label: 'Balance Wheel (online)', href: '/balance-wheel/' },
  { label: 'Newsletter', href: '/newsletter/' },
  { label: 'Work & resume', href: '/about/resume/' },
  { label: 'Contact', href: '/contact/' },
  { label: 'Privacy', href: '/privacy/' },
  { label: 'RSS', href: '/rss.xml' },
];
---

<footer class="border-t border-on-dark-line bg-ink text-paper">
  <div class="mx-auto max-w-(--container-wide) px-5 py-16 sm:px-8 sm:py-20">
    <div class="grid gap-14 lg:grid-cols-12 lg:gap-8">
      <div class="lg:col-span-5">
        <a href="/" aria-label="Home" class="inline-flex">
          <Wordmark size="large" />
        </a>
        <p class="mt-8 max-w-sm text-on-dark-muted">
          One practical idea a day from my books, on YouTube. Start with the free Balance Wheel worksheet.
        </p>
        <div class="mt-6">
          <Button href="/start/" arrow data-cta="footer-worksheet">Get the free worksheet</Button>
        </div>
      </div>

      <nav aria-label="Explore" class="lg:col-span-2 lg:col-start-7">
        <p class="label text-accent">Explore</p>
        <ul class="mt-4 flex flex-col">
          {NAV_ITEMS.map((item) => (
            <li><a href={item.href} class="flex min-h-10 items-center text-on-dark-muted transition-colors hover:text-paper">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <nav aria-label="More" class="lg:col-span-2">
        <p class="label text-accent">More</p>
        <ul class="mt-4 flex flex-col">
          {more.map((item) => (
            <li><a href={item.href} class="flex min-h-10 items-center text-on-dark-muted transition-colors hover:text-paper">{item.label}</a></li>
          ))}
        </ul>
      </nav>

      <div class="lg:col-span-2">
        <p class="label text-accent">Follow</p>
        <ul class="mt-4 flex flex-col">
          {SOCIAL_LINKS.map((s) => (
            <li>
              <a href={s.href} target="_blank" rel="noopener noreferrer" data-cta={`footer-${s.label.toLowerCase()}`} class="flex min-h-10 items-center text-on-dark-muted transition-colors hover:text-paper">
                {s.label}
              </a>
            </li>
          ))}
          <li>
            <a href={`mailto:${SITE.contactEmail}`} data-cta="footer-email" class="flex min-h-10 items-center break-all text-on-dark-muted transition-colors hover:text-paper">
              Email
            </a>
          </li>
        </ul>
        <p class="mt-4 text-sm text-on-dark-muted">{YOUTUBE.handle}</p>
      </div>
    </div>

    <div class="mt-16 flex flex-col gap-2 border-t border-on-dark-line pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="label text-on-dark-muted">&copy; {year} {SITE.name} · Muscat, Oman</p>
      <p class="label text-on-dark-muted">Engineer your time · Coach yourself · Live in balance</p>
    </div>
  </div>
</footer>
