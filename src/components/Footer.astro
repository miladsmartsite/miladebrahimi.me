---
import { SITE, NAV_ITEMS } from '@lib/site';
import SocialLinks from '@components/SocialLinks.astro';

const year = new Date().getFullYear();
---

<footer class="border-t border-ink-100 bg-paper">
  <div class="mx-auto max-w-(--container-wide) px-6 py-14 sm:px-8">
    <div class="flex flex-col gap-10 sm:flex-row sm:items-start sm:justify-between">
      <div>
        <a href="/" class="font-display text-lg text-ink-950">{SITE.brandName}</a>
        <p class="mt-2 max-w-xs text-sm text-ink-500">{SITE.positioning}</p>
      </div>

      <nav aria-label="Footer">
        <ul class="grid grid-cols-2 gap-x-10 gap-y-2 sm:flex sm:flex-wrap sm:gap-8">
          {NAV_ITEMS.map((item) => (
            <li>
              <a href={item.href} class="text-sm text-ink-500 transition-colors hover:text-accent-ink">
                {item.label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </div>

    <div class="mt-12 flex flex-col-reverse items-start gap-4 border-t border-ink-100 pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="text-xs text-ink-500">&copy; {year} {SITE.name}. All rights reserved.</p>
      <SocialLinks />
    </div>
  </div>
</footer>
