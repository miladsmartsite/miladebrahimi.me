---
/**
 * Editorial system-portfolio card — richer than a generic project card.
 * Surfaces Problem / Tools / Result at a glance, with an explicit,
 * non-invented distinction between a confirmed outcome and "evidence in
 * development." Used on the homepage Selected Systems section and the
 * /projects listing.
 */
import type { CollectionEntry } from 'astro:content';
import PlaceholderTag from '@components/PlaceholderTag.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const { title, problem, outcome, evidenceNote, tools, client, year, placeholder, redacted } =
  project.data;
const href = project.data.externalUrl ?? `/projects/${project.id}`;
const result = outcome ?? evidenceNote;
---

<a
  href={href}
  class="group/card block border-b border-ink-100 py-10 transition-colors first:border-t sm:py-12"
>
  <div class="grid gap-6 sm:grid-cols-12 sm:gap-8">
    <div class="sm:col-span-4">
      <div class="flex items-center gap-3">
        {typeof index === 'number' && (
          <span class="font-sans text-sm text-ink-500 tabular-nums">
            {String(index + 1).padStart(2, '0')}
          </span>
        )}
        {placeholder && <PlaceholderTag />}
      </div>
      <h3 class="mt-2 font-display text-2xl leading-tight text-ink-950 transition-colors group-hover/card:text-accent-ink sm:text-[1.75rem]">
        {title}
      </h3>
      <p class="mt-2 text-xs text-ink-500">
        {client}
        {year && <span> · {year}</span>}
        {redacted && <span> · Details redacted</span>}
      </p>
    </div>

    <div class="sm:col-span-4">
      {problem && (
        <>
          <p class="text-xs font-semibold tracking-wide text-accent uppercase">Problem</p>
          <p class="mt-1.5 text-sm text-ink-700">{problem}</p>
        </>
      )}
      {tools.length > 0 && (
        <ul class="mt-4 flex flex-wrap gap-x-3 gap-y-1">
          {tools.map((tool) => (
            <li class="text-xs tracking-wide text-ink-500 uppercase">{tool}</li>
          ))}
        </ul>
      )}
    </div>

    <div class="flex flex-col justify-between gap-4 sm:col-span-4">
      <div>
        <p class="text-xs font-semibold tracking-wide text-accent uppercase">
          {outcome ? 'Result' : 'Evidence'}
        </p>
        <p class="mt-1.5 text-sm text-ink-700">{result}</p>
      </div>
      <span
        aria-hidden="true"
        class="inline-flex items-center gap-1 text-xs font-medium text-ink-500 transition-colors group-hover/card:text-accent-ink"
      >
        Read the system
        <span class="transition-transform duration-(--duration-fast) group-hover/card:translate-x-1">→</span>
      </span>
    </div>
  </div>
</a>
