---
/**
 * Selected-systems archive entry — not a generic card. A large display
 * numeral anchors each row; title, description, metadata, domain ticks,
 * and a conceptual SystemPreview visual sit alongside it; the
 * problem/result detail panel is progressively disclosed on hover or
 * focus (desktop) and always visible on touch, since there's no hover
 * there. Used on the homepage Selected Systems section and the /projects
 * archive — data-tag on the root element supports the CSS-only filter on
 * /projects.
 */
import type { CollectionEntry } from 'astro:content';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import SystemPreview from '@components/SystemPreview.astro';
import { DOMAIN_CODES } from '@lib/site';

interface Props {
  project: CollectionEntry<'projects'>;
  index?: number;
}

const { project, index } = Astro.props;
const {
  title,
  summary,
  problem,
  outcome,
  evidenceNote,
  tools,
  tags,
  role,
  client,
  year,
  placeholder,
  redacted,
  previewType,
} = project.data;
const href = project.data.externalUrl ?? `/projects/${project.id}`;
const result = outcome ?? evidenceNote;
---

<a
  href={href}
  data-tags={tags.join(' ')}
  class="group/card system-entry block border-b border-line py-10 transition-colors first:border-t sm:py-12"
>
  <div class="grid gap-6 lg:grid-cols-12 lg:gap-10">
    <div class="lg:col-span-1">
      <span class="font-display text-4xl leading-none font-bold text-line transition-colors sm:text-5xl lg:text-6xl group-hover/card:text-accent-tint">
        {typeof index === 'number' ? String(index + 1).padStart(2, '0') : '—'}
      </span>
    </div>

    <div class="lg:col-span-7">
      <div class="flex flex-wrap items-center gap-3">
        <h3 class="font-display text-2xl leading-tight font-bold tracking-[-0.02em] text-ink transition-colors group-hover/card:text-accent-ink sm:text-[1.75rem]">
          {title}
        </h3>
        {placeholder && <PlaceholderTag />}
      </div>
      <p class="mt-2 max-w-2xl font-body text-lg text-body">{summary}</p>

      <ul class="mt-4 flex flex-wrap gap-x-6 gap-y-1 font-mono text-[11px] tracking-wide text-meta uppercase">
        {role && <li>{role}</li>}
        {client && <li>{client}</li>}
        {year && <li>{year}{redacted && ' · Redacted'}</li>}
      </ul>

      <div class="mt-5 flex items-center gap-1.5" aria-hidden="true">
        {DOMAIN_CODES.map((domain) => (
          <span
            class:list={[
              'flex h-4 items-center border px-1.5 font-mono text-[10px] font-medium tracking-wide',
              tags.includes(domain.tag)
                ? 'border-accent bg-accent-tint text-accent-ink'
                : 'border-line text-line',
            ]}
          >
            {domain.code}
          </span>
        ))}
      </div>

      <div class="mt-5 max-w-[11rem] lg:hidden">
        <SystemPreview type={previewType ?? 'dashboard'} class="opacity-70" />
      </div>

      <div class="mt-6 grid grid-rows-[1fr] opacity-100 transition-all duration-(--duration-base) sm:mt-0 sm:grid-rows-[0fr] sm:opacity-0 sm:group-hover/card:mt-6 sm:group-hover/card:grid-rows-[1fr] sm:group-hover/card:opacity-100 sm:group-focus-within/card:mt-6 sm:group-focus-within/card:grid-rows-[1fr] sm:group-focus-within/card:opacity-100">
        <div class="overflow-hidden">
          <div class="grid gap-6 border-t border-line pt-6 sm:grid-cols-2">
            {problem && (
              <div>
                <p class="font-mono text-[11px] font-bold tracking-wide text-accent-ink uppercase">Problem</p>
                <p class="mt-1.5 font-body text-base text-body">{problem}</p>
              </div>
            )}
            <div>
              <p class="font-mono text-[11px] font-bold tracking-wide text-accent-ink uppercase">
                {outcome ? 'Result' : 'Evidence'}
              </p>
              <p class="mt-1.5 font-body text-base text-body">{result}</p>
            </div>
          </div>
          {tools.length > 0 && (
            <ul class="mt-4 flex flex-wrap gap-2">
              {tools.map((tool) => (
                <li class="border border-line px-2.5 py-1 font-mono text-[10px] tracking-wide text-body uppercase">
                  {tool}
                </li>
              ))}
            </ul>
          )}
        </div>
      </div>

      <span
        aria-hidden="true"
        class="mt-5 inline-flex items-center gap-1 font-mono text-[11px] font-medium tracking-wide text-meta uppercase transition-colors group-hover/card:text-accent-ink"
      >
        Explore system
        <span class="transition-transform duration-(--duration-fast) group-hover/card:translate-x-1">→</span>
      </span>
    </div>

    <div class="hidden items-center lg:col-span-4 lg:flex">
      <SystemPreview type={previewType ?? 'dashboard'} class="opacity-65 transition-colors duration-(--duration-base) group-hover/card:text-accent group-hover/card:opacity-100" />
    </div>
  </div>
</a>
