---
/**
 * Homepage hero. Asymmetric editorial composition: a large display
 * headline on the left, a shorter supporting column on the right carrying
 * the brand's one distinctive visual (the system diagram), the subhead,
 * and the CTAs. The headline reveals word-by-word on load (CSS-only, no
 * JS) via a clipped-mask slide.
 */
import SystemDiagram from '@components/home/SystemDiagram.astro';

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  note?: string;
}

const { eyebrow, title, subtitle, note } = Astro.props;
const words = title.split(' ');
---

<div class="mx-auto max-w-(--container-wide) px-6 pt-16 pb-20 sm:px-8 sm:pt-20 lg:pb-28">
  <div class="grid gap-12 lg:grid-cols-12 lg:gap-8">
    <div class="lg:col-span-7">
      {eyebrow && (
        <p class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-sans text-sm font-medium tracking-wide text-ink-500">
          <span class="inline-block h-px w-8 origin-left bg-accent align-middle motion-safe:animate-hero-rule" aria-hidden="true"></span>
          {eyebrow}
        </p>
      )}
      <h1 class="max-w-3xl font-display text-[2.75rem] leading-[1.05] font-medium text-ink-950 sm:text-6xl lg:text-7xl">
        {words.map((word, i) => (
          <span class="inline-block overflow-hidden pb-1 align-bottom">
            <span
              class="inline-block motion-safe:animate-hero-in"
              style={`animation-delay:${120 + i * 70}ms`}
            >
              {word}&nbsp;
            </span>
          </span>
        ))}
      </h1>
      {subtitle && <p class="mt-6 max-w-lg text-lg text-ink-700">{subtitle}</p>}
      <div class="mt-8 flex flex-wrap items-center gap-4">
        <slot />
      </div>
      {note && <p class="mt-6 text-xs text-ink-500 italic">{note}</p>}
    </div>

    <div class="flex items-center justify-center lg:col-span-5">
      <SystemDiagram />
    </div>
  </div>
</div>
