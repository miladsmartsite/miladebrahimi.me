---
/**
 * Homepage hero — the signature brand moment. Full ink surface; on the
 * left an oversized editorial statement, on the right a portrait "identity
 * plate": a framed, annotated composition (corner marks, fig. label, name
 * plate) that stays visually dominant even while the portrait itself is a
 * placeholder — the frame and typography carry the weight, not the photo.
 * The System Map used to live compressed into this corner; it now gets
 * its own full-width moment further down the page (see index.astro).
 */
import Portrait from '@components/Portrait.astro';

interface Props {
  masthead: string;
  eyebrow?: string;
  title: string;
  subtitle?: string;
  note?: string;
  /** Real, computed facts — e.g. "07" practice areas, "05" systems built. */
  stats?: { label: string; value: string }[];
}

const { masthead, eyebrow, title, subtitle, note, stats = [] } = Astro.props;
---

<div class="field-grid relative overflow-hidden bg-ink text-paper">
  <div class="relative mx-auto max-w-(--container-wide) px-6 pt-12 pb-16 sm:px-8 sm:pt-14 lg:pb-24">
    <div class="grid gap-16 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-7">
        <p class="mb-5 font-mono text-[11px] font-bold tracking-[0.16em] text-on-dark-muted uppercase">
          {masthead}
        </p>
        {eyebrow && (
          <p class="mb-6 flex flex-wrap items-center gap-x-3 gap-y-1 font-body text-base text-on-dark-muted italic">
            <span class="brass-rule inline-block h-px w-8 align-middle" aria-hidden="true"></span>
            {eyebrow}
          </p>
        )}
        <h1 class="max-w-3xl font-display text-[2.75rem] leading-[1.04] font-bold tracking-[-0.04em] text-paper uppercase sm:text-6xl lg:text-[4.25rem]">
          {title}
        </h1>
        {subtitle && <p class="mt-6 max-w-lg font-body text-lg text-on-dark-muted">{subtitle}</p>}
        <div class="mt-8 flex flex-wrap items-center gap-6">
          <slot />
        </div>
        {note && <p class="mt-6 font-body text-sm text-on-dark-muted italic">{note}</p>}

        {stats.length > 0 && (
          <dl class="mt-12 grid max-w-lg grid-cols-3 gap-6 border-t border-on-dark-line pt-6">
            {stats.map((stat) => (
              <div>
                <dt class="font-mono text-[10px] tracking-[0.1em] text-on-dark-muted uppercase">{stat.label}</dt>
                <dd class="mt-1 font-display text-2xl font-bold text-paper tabular-nums">{stat.value}</dd>
              </div>
            ))}
          </dl>
        )}
      </div>

      <div class="lg:col-span-5">
        <div class="relative mx-auto max-w-sm lg:max-w-none">
          <span class="absolute -top-3 -left-3 h-7 w-7 border-t border-l border-accent" aria-hidden="true"></span>
          <span class="absolute -right-3 -bottom-3 h-7 w-7 border-r border-b border-accent" aria-hidden="true"></span>

          <div class="border border-on-dark-line p-3">
            <div class="mb-3 flex items-center justify-between font-mono text-[10px] tracking-[0.14em] text-on-dark-muted uppercase">
              <span>Fig. 01 — Profile</span>
              <span>4:5</span>
            </div>

            <Portrait class="border border-on-dark-line" />

            <div class="mt-4 flex items-end justify-between gap-4 border-t border-on-dark-line pt-4">
              <div>
                <p class="font-display text-xl font-bold tracking-[-0.02em] text-paper">MILAD EBRAHIMI</p>
                <p class="mt-1.5 font-mono text-[10px] tracking-[0.12em] text-on-dark-muted uppercase">
                  Operations · Systems · Strategy · AI
                </p>
              </div>
              <span class="mb-0.5 size-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
            </div>
          </div>

          {/* A small editorial technical drawing, not a SaaS dashboard —
              the same input→output logic every system on /projects
              follows, reduced to its plainest form. */}
          <div class="mt-5 flex items-center gap-1.5 font-mono text-[9px] tracking-[0.1em] text-on-dark-muted uppercase sm:text-[10px]">
            <span>Input</span>
            <span class="h-px flex-1 bg-on-dark-line" aria-hidden="true"></span>
            <span class="flex items-center gap-1.5 text-accent">
              <span class="size-1 shrink-0 rounded-full bg-accent" aria-hidden="true"></span>
              System
            </span>
            <span class="h-px flex-1 bg-on-dark-line" aria-hidden="true"></span>
            <span>Process</span>
            <span class="h-px flex-1 bg-on-dark-line" aria-hidden="true"></span>
            <span>Result</span>
          </div>
        </div>
      </div>
    </div>

    <div class="mt-16 flex items-center gap-3 font-mono text-[11px] tracking-[0.16em] text-on-dark-muted uppercase lg:mt-20">
      <span class="h-6 w-px bg-on-dark-line" aria-hidden="true"></span>
      Scroll
    </div>
  </div>
</div>
