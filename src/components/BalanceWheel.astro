---
/**
 * The Balance Wheel from Self-Coaching Blueprint (p. 59 order): eight
 * spokes, rings 1–10. With `scores` it draws an example wheel; the shape
 * is illustrative, never anyone's real result.
 */
import { WORKSHEET } from '@lib/site';

interface Props {
  /** One score (1–10) per area, in WORKSHEET.areas order. */
  scores?: number[];
  tone?: 'dark' | 'paper';
  labels?: boolean;
  class?: string;
}

const { scores, tone = 'dark', labels = true, class: className = '' } = Astro.props;
const R = 45;
const dark = tone === 'dark';
const ring = dark ? 'rgba(244,239,230,.12)' : 'rgba(20,20,20,.12)';
const spoke = dark ? 'rgba(244,239,230,.28)' : 'rgba(20,20,20,.35)';
const text = dark ? '#a8a196' : '#6b665e';
const accent = dark ? '#C49A5A' : '#9A6B2A';

const angle = (i: number) => -Math.PI / 2 + (i * Math.PI) / 4;
const pt = (i: number, r: number) => [r * Math.cos(angle(i)), r * Math.sin(angle(i))].map((n) => n.toFixed(2));
const shape = scores ? scores.map((s, i) => pt(i, (R * s) / 10).join(',')).join(' ') : '';
---

<svg viewBox="-84 -60 168 120" class={className} role="img" aria-label={labels ? `Balance Wheel: ${WORKSHEET.areas.join(', ')}` : 'Balance Wheel'}>
  <g fill="none" stroke={ring} stroke-width="0.4">
    {[2, 4, 6, 8, 10].map((k) => <circle r={(R * k) / 10} />)}
  </g>
  <g stroke={spoke} stroke-width="0.4">
    {WORKSHEET.areas.map((_, i) => {
      const [x, y] = pt(i, R);
      return <line x2={x} y2={y} />;
    })}
  </g>
  {scores && <polygon points={shape} fill={dark ? 'rgba(196,154,90,.14)' : 'rgba(154,107,42,.12)'} stroke={accent} stroke-width="1.1" stroke-linejoin="round" />}
  {scores && scores.map((s, i) => {
    const [x, y] = pt(i, (R * s) / 10);
    return <circle cx={x} cy={y} r="1.5" fill={accent} />;
  })}
  <circle r="1.2" fill={accent} />
  {labels && (
    <g font-family="Inter, sans-serif" font-weight="600" font-size="4.3" letter-spacing="0.5" fill={text}>
      {WORKSHEET.areas.map((area, i) => {
        const c = Math.cos(angle(i));
        const s = Math.sin(angle(i));
        const r = R + 5;
        const anchor = c > 0.3 ? 'start' : c < -0.3 ? 'end' : 'middle';
        return (
          <text x={(r * c).toFixed(2)} y={(r * s + (s > 0.5 ? 3.5 : s < -0.5 ? -0.5 : 1.5)).toFixed(2)} text-anchor={anchor}>
            {area.toUpperCase()}
          </text>
        );
      })}
    </g>
  )}
</svg>
