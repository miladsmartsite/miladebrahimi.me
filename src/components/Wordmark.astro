---
/**
 * Horizontal lockup: monogram + "Milad Ebrahimi". The large size adds the
 * brand rule and the tracked tagline, as on the YouTube wordmark.
 */
import Monogram from '@components/Monogram.astro';
import { SITE } from '@lib/site';

interface Props {
  size?: 'default' | 'large';
  /** Kept for older callers: true = ivory on charcoal (the default here). */
  reversed?: boolean;
  tone?: 'ivory' | 'charcoal';
}

const { size = 'default', reversed = true, tone = reversed ? 'ivory' : 'charcoal' } = Astro.props;
const nameColor = tone === 'ivory' ? 'text-paper' : 'text-ink';
---

{size === 'large' ? (
  <span class="inline-flex flex-col">
    <span class={`font-display text-3xl leading-none font-extrabold tracking-[-0.045em] sm:text-4xl ${nameColor}`}>{SITE.name}</span>
    <span class={`mt-4 block h-1 w-20 ${tone === 'ivory' ? 'bg-accent' : 'bg-accent-ink'}`}></span>
    <span class={`label mt-4 ${tone === 'ivory' ? 'text-on-dark-muted' : 'text-meta'}`}>Time Engineering · Self-Coaching · Balance</span>
  </span>
) : (
  <span class="inline-flex items-center gap-3">
    <Monogram size={20} tone={tone} />
    <span class={`font-display text-[17px] leading-none font-extrabold tracking-[-0.03em] ${nameColor}`}>{SITE.name}</span>
  </span>
)}
