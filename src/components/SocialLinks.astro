---
import { SOCIAL_LINKS } from '@lib/site';

interface Props {
  class?: string;
  /** For use on a navy surface (e.g. the footer) — swaps to light-on-dark colors. */
  dark?: boolean;
}

const { class: className = '', dark = false } = Astro.props;
const linkClass = dark
  ? 'flex min-h-11 items-center text-sm text-ink-300 transition-colors hover:text-accent'
  : 'flex min-h-11 items-center text-sm text-ink-500 transition-colors hover:text-accent-ink';
---

{
  SOCIAL_LINKS.length > 0 && (
    <ul class={`flex items-center gap-4 ${className}`}>
      {SOCIAL_LINKS.map((link) => (
        <li>
          <a href={link.href} class={linkClass} target="_blank" rel="noopener noreferrer">
            {link.label}
          </a>
        </li>
      ))}
    </ul>
  )
}
