---
/**
 * Full-screen mobile navigation overlay. Rendered as a sibling of <Nav />
 * in BaseLayout — deliberately NOT nested inside the header — so its
 * `position: fixed; inset: 0` is guaranteed to resolve against the real
 * viewport, not some ancestor's containing block. Fully opaque ink
 * surface: nothing behind it stays readable. Covers: real 44×44px touch
 * targets throughout, body-scroll lock, Escape-to-close, click-link-to-
 * close, a focus trap while open, and a staggered reveal that respects
 * prefers-reduced-motion (the global reduced-motion rule in global.css
 * zeroes every transition/animation duration automatically).
 *
 * Phase 6: the four grouped items (Expertise/Work/Contents/About Me &
 * Resume) are no longer flat links — each is a native <details> holding
 * the same brand-orientation content as the desktop MegaMenu (reusing
 * MEGA_MENUS from site.ts, not a squeezed-down copy of it), so mobile
 * gets its own full-screen expandable presentation rather than the
 * desktop panel crammed into a small viewport. Home and Contact stay
 * plain links, matching the desktop nav where Contact is never forced
 * into a menu.
 */
import { getCollection } from 'astro:content';
import { MEGA_MENUS, SITE, SOCIAL_LINKS } from '@lib/site';
import Wordmark from '@components/Wordmark.astro';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const systems = allProjects.sort((a, b) => a.data.order - b.data.order);

const megaMenus: typeof MEGA_MENUS = {
  ...MEGA_MENUS,
  Work: {
    ...MEGA_MENUS.Work,
    groups: [
      {
        heading: 'Systems',
        links: systems.map((p) => ({ label: p.data.title, href: `/projects/${p.id}` })),
      },
    ],
  },
};

// Home + the four grouped destinations + Contact, in the established
// mobile order — built here (not read from MOBILE_NAV_ITEMS) since each
// entry now needs to know whether it expands.
const entries = [
  { label: 'Home', href: '/' },
  { label: 'Expertise', href: '/expertise', menu: megaMenus.Expertise },
  { label: 'Work', href: '/projects', menu: megaMenus.Work },
  { label: 'Contents', href: '/contents', menu: megaMenus.Contents },
  { label: 'About Me & Resume', href: '/resume', menu: megaMenus['About Me & Resume'] },
  { label: 'Contact', href: '/contact' },
];
---

<nav
  id="mobile-nav-panel"
  hidden
  aria-label="Mobile"
  class="fixed inset-0 z-[100] flex scale-95 flex-col bg-ink opacity-0 transition-all duration-(--duration-base) md:hidden"
  style="padding-top:max(1.25rem, env(safe-area-inset-top)); padding-bottom:max(1.5rem, env(safe-area-inset-bottom));"
>
  {/* Header row — aligns with the page header's own padding so the
      toggle button (fixed above this panel, top-right) reads as this
      row's close control. */}
  <div class="flex shrink-0 items-center border-b border-on-dark-line px-6 pb-5 sm:px-8">
    <a href="/" aria-label="Home" class="flex h-11 items-center">
      <Wordmark size="small" reversed />
    </a>
  </div>

  <div class="flex flex-1 flex-col justify-between overflow-y-auto px-6 sm:px-8">
    <ol class="flex flex-col">
      {entries.map((entry, index) => (
        <li
          class="mobile-nav-item translate-y-2 border-b border-on-dark-line opacity-0 transition-all duration-(--duration-base)"
          style={`transition-delay:${index * 45}ms`}
        >
          {entry.menu ? (
            <details class="group/details">
              <summary class="group/item flex min-h-16 cursor-pointer list-none items-center justify-between gap-4 py-3 transition-colors sm:min-h-[4.5rem]">
                <span class="flex items-center gap-4">
                  <span class="font-mono text-[13px] text-on-dark-muted tabular-nums transition-colors group-hover/item:text-accent">
                    {String(index + 1).padStart(2, '0')}
                  </span>
                  <span class="font-display text-3xl font-bold tracking-[-0.02em] text-paper transition-colors group-hover/item:text-accent sm:text-4xl">
                    {entry.label}
                  </span>
                </span>
                <span class="flex size-11 shrink-0 items-center justify-center font-mono text-lg text-on-dark-muted transition-transform duration-(--duration-fast) group-open/details:rotate-45" aria-hidden="true">
                  +
                </span>
              </summary>

              <div class="pb-6 pl-11">
                <p class="max-w-xs font-body text-base text-on-dark-muted">{entry.menu.statement}</p>
                <div class="mt-5 space-y-6">
                  {entry.menu.groups.map((group) => (
                    <div>
                      {group.heading && (
                        <p class="mb-3 font-mono text-[11px] font-bold tracking-[0.14em] text-on-dark-muted uppercase">{group.heading}</p>
                      )}
                      <ul class="space-y-1">
                        {group.links.map((link) => (
                          <li>
                            <a href={link.href} class="group/link flex min-h-11 items-center justify-between gap-3 py-1">
                              <span class="font-body text-lg text-paper transition-colors group-hover/link:text-accent">{link.label}</span>
                              {link.status === 'in-development' ? (
                                <span class="shrink-0 font-mono text-[9px] tracking-wide text-on-dark-muted uppercase">In Dev.</span>
                              ) : link.description ? (
                                <span class="shrink-0 font-mono text-[10px] tracking-wide text-on-dark-muted uppercase">{link.description}</span>
                              ) : null}
                            </a>
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))}
                </div>
                <a
                  href={entry.href}
                  class="mt-6 inline-flex min-h-11 items-center gap-1.5 font-mono text-[13px] font-medium text-accent underline decoration-on-dark-line underline-offset-4 hover:decoration-accent"
                >
                  View {entry.label} →
                </a>
              </div>
            </details>
          ) : (
            <a
              href={entry.href}
              class="group/item flex min-h-16 items-center gap-4 py-3 transition-colors sm:min-h-[4.5rem]"
            >
              <span class="font-mono text-[13px] text-on-dark-muted tabular-nums transition-colors group-hover/item:text-accent group-active/item:text-accent">
                {String(index + 1).padStart(2, '0')}
              </span>
              <span class="font-display text-3xl font-bold tracking-[-0.02em] text-paper transition-colors group-hover/item:text-accent group-active/item:text-accent sm:text-4xl">
                {entry.label}
              </span>
            </a>
          )}
        </li>
      ))}
    </ol>

    <div class="mobile-nav-item flex shrink-0 translate-y-2 flex-col gap-5 py-8 opacity-0 transition-all duration-(--duration-base)" style={`transition-delay:${entries.length * 45}ms`}>
      <p class="max-w-xs font-body text-base text-on-dark-muted">{SITE.positioning}</p>

      <div class="flex flex-wrap items-center gap-4">
        <a
          href="/contact"
          class="inline-flex min-h-11 items-center border border-accent px-5 py-2.5 font-mono text-[13px] font-medium text-accent transition-colors hover:bg-accent-tint hover:text-ink"
        >
          Get in touch
        </a>
        <a
          href={SITE.cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex min-h-11 items-center font-mono text-[13px] font-medium text-on-dark-muted underline decoration-on-dark-line underline-offset-4 transition-colors hover:text-accent hover:decoration-accent"
        >
          Download CV
        </a>
      </div>

      {SOCIAL_LINKS.length > 0 && (
        <ul class="flex items-center gap-5 border-t border-on-dark-line pt-5">
          {SOCIAL_LINKS.map((link) => (
            <li>
              <a
                href={link.href}
                target="_blank"
                rel="noopener noreferrer"
                class="inline-flex min-h-11 items-center font-mono text-[11px] tracking-[0.12em] text-on-dark-muted uppercase transition-colors hover:text-accent"
              >
                {link.label}
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</nav>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const items = document.querySelectorAll<HTMLElement>('.mobile-nav-item');
  let closeTimer: number | undefined;

  function getFocusable(): HTMLElement[] {
    if (!panel) return [];
    return Array.from(panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled]), summary'));
  }

  function trapFocus(event: KeyboardEvent) {
    if (event.key !== 'Tab') return;
    const focusable = getFocusable();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function setOpen(isOpen: boolean) {
    if (!toggle || !panel) return;
    window.clearTimeout(closeTimer);
    toggle.setAttribute('aria-expanded', String(isOpen));

    if (isOpen) {
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      // Force a reflow between un-hiding and the class change below, so the
      // browser commits the "hidden" removal first and the opacity/scale/
      // translate transitions actually animate instead of jumping straight
      // to the end state. (More reliable across environments than
      // requestAnimationFrame, which can be throttled.)
      void panel.offsetHeight;
      panel.classList.remove('opacity-0', 'scale-95');
      panel.classList.add('opacity-100', 'scale-100');
      items.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-2');
        item.classList.add('opacity-100', 'translate-y-0');
      });
      document.addEventListener('keydown', trapFocus);
      // Focus the first real nav link, not the wordmark above it.
      (panel.querySelector<HTMLElement>('.mobile-nav-item a, .mobile-nav-item summary') ?? getFocusable()[0])?.focus();
    } else {
      panel.classList.remove('opacity-100', 'scale-100');
      panel.classList.add('opacity-0', 'scale-95');
      items.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-2');
        item.classList.remove('opacity-100', 'translate-y-0');
      });
      document.body.style.overflow = '';
      document.removeEventListener('keydown', trapFocus);
      closeTimer = window.setTimeout(() => {
        panel.hidden = true;
        // Collapse any expanded groups so the panel reopens fresh next time.
        panel.querySelectorAll('details[open]').forEach((details) => details.removeAttribute('open'));
      }, 300);
      toggle.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
    }
  });
</script>
