---
/**
 * The closing "about the author" block on every article.
 */
import Portrait from '@components/Portrait.astro';
import { SITE } from '@lib/site';
---

<div class="flex flex-col gap-5 border-t border-line pt-8 sm:flex-row sm:items-start">
  <div class="w-20 shrink-0">
    <Portrait aspect="1:1" />
  </div>
  <div>
    <p class="label text-accent-ink">About the author</p>
    <p class="mt-2 font-display text-xl font-extrabold tracking-[-0.025em] text-ink">{SITE.name}</p>
    <p class="mt-2 max-w-xl text-body">
      Productivity coach with 10+ years of coaching, author of Self-Coaching Blueprint and Time Engineering, and founder of ME Academy. Based in Muscat, Oman.
    </p>
    <a
      href="/about/"
      data-cta="author-block-about"
      class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent-ink underline decoration-2 underline-offset-[6px]"
    >
      More about Milad →
    </a>
  </div>
</div>
