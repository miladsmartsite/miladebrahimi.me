---
/**
 * One video, linking out to YouTube (no embedded player: faster pages and
 * no third-party player until the visitor chooses to watch). Shorts are
 * 9:16; the hqdefault thumbnail of a Short is the vertical frame centred
 * in a 4:3 image, so `object-cover` in a 9:16 box shows exactly that frame.
 */
import type { Video } from '@lib/youtube';

interface Props {
  video: Video;
  source: string;
}

const { video, source } = Astro.props;
const date = video.published.toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric', timeZone: 'Asia/Muscat' });
---

<a href={video.url} target="_blank" rel="noopener noreferrer" data-cta={`video-${source}`} class="group/video block min-w-0">
  <div class:list={['relative overflow-hidden bg-ink-soft', video.short ? 'aspect-[9/16]' : 'aspect-video']}>
    <img
      src={video.thumbnail}
      alt=""
      loading="lazy"
      decoding="async"
      width="480"
      height="360"
      class="h-full w-full object-cover transition-transform duration-(--duration-base) group-hover/video:scale-[1.03]"
    />
    <span class="label absolute bottom-0 left-0 bg-ink px-2.5 py-1.5 text-[10px] text-paper">{video.short ? 'Short' : 'Video'}</span>
  </div>
  <p class="mt-3 font-display text-[17px] leading-snug font-bold tracking-[-0.015em] text-paper transition-colors group-hover/video:text-accent">
    {video.title}
  </p>
  <p class="label mt-2 text-[11px] text-on-dark-muted"><time datetime={video.published.toISOString()}>{date}</time></p>
</a>
