---
/**
 * Polymorphic button/link: an <a> when `href` is set, otherwise a <button>.
 * Square, flat, 2px bronze border: the same buttons as /start and the
 * YouTube end screens.
 *
 *   primary   bronze fill, charcoal text (the one main action per view)
 *   secondary bronze border, text in the surrounding colour
 *   dark      charcoal fill, ivory text (for ivory sections)
 *   ghost     underlined text link with an arrow
 *   accent    alias of primary (older callers)
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'dark' | 'ghost';
  size?: 'default' | 'small';
  type?: 'button' | 'submit' | 'reset';
  arrow?: boolean;
  /** Opens in a new tab with rel="noopener noreferrer", for off-site links. */
  external?: boolean;
  download?: boolean;
  class?: string;
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'primary',
  size = 'default',
  type = 'button',
  arrow = false,
  external = false,
  download = false,
  class: className = '',
  ...rest
} = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2.5 font-body font-semibold transition-colors duration-(--duration-fast) focus-visible:outline-2 focus-visible:outline-offset-3';
const sizes: Record<string, string> = {
  default: 'min-h-12 px-6 text-[15px]',
  small: 'min-h-10 px-4 text-[13px] tracking-[0.04em]',
};
const variants: Record<string, string> = {
  primary: 'border-2 border-accent bg-accent text-ink hover:bg-paper hover:border-paper',
  accent: 'border-2 border-accent bg-accent text-ink hover:bg-paper hover:border-paper',
  secondary: 'border-2 border-accent text-current hover:bg-accent hover:text-ink',
  dark: 'border-2 border-ink bg-ink text-paper hover:border-accent-ink hover:bg-accent-ink',
  ghost: 'min-h-11 px-0 text-[15px] underline decoration-2 decoration-accent underline-offset-[6px] hover:text-accent',
};

const classes = [base, variant === 'ghost' ? '' : sizes[size], variants[variant], className].join(' ');
---

{
  href ? (
    <a
      href={href}
      class={classes}
      target={external ? '_blank' : undefined}
      rel={external ? 'noopener noreferrer' : undefined}
      download={download || undefined}
      {...rest}
    >
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-1">
          →
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-1">
          →
        </span>
      )}
    </button>
  )
}
