---
/**
 * Polymorphic button/link. Renders an <a> when `href` is set, otherwise a
 * <button>. `arrow` appends a small glyph that shifts on hover/focus —
 * the site's one recurring micro-interaction for calls to action.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  arrow?: boolean;
  /** Opens in a new tab with rel="noopener noreferrer" — for links off-site. */
  external?: boolean;
  class?: string;
  /** Any other attribute (data-cta, aria-*, etc.) passes straight through
   * to the rendered element — e.g. tagging a CTA for future analytics
   * without the component needing to know what that means. */
  [key: `data-${string}`]: string | undefined;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  arrow = false,
  external = false,
  class: className = '',
  ...rest
} = Astro.props;

const base = 'group/btn inline-flex items-center justify-center gap-2 transition-colors duration-(--duration-fast) focus-visible:outline-2 focus-visible:outline-offset-2';

// Brass is a metal, not a highlighter — no variant fills a large surface
// with raw --color-accent. The tint-fill ("accent") variant pairs
// --color-accent-tint with --color-ink text; verified WCAG AA. "ghost" is
// the Crimson Pro italic link treatment used for secondary actions.
const variants: Record<string, string> = {
  primary:
    'px-5 py-2.5 font-mono text-[13px] font-medium tracking-wide uppercase bg-ink text-paper hover:bg-accent-tint hover:text-ink',
  accent:
    'px-5 py-2.5 font-mono text-[13px] font-medium tracking-wide uppercase bg-accent-tint text-ink hover:brightness-95',
  secondary:
    'px-5 py-2.5 font-mono text-[13px] font-medium tracking-wide uppercase border border-ink text-ink hover:border-accent hover:text-accent-ink',
  // min-h-11 gives the invisible tap target a real 44px height without
  // adding any visible padding/box — the link still reads as plain
  // italic text, it's just centered inside a taller invisible hit area.
  ghost: 'min-h-11 font-body text-[17px] italic text-ink hover:text-accent-ink',
};

const classes = [base, variants[variant], className].join(' ');
---

{
  href ? (
    <a href={href} class={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} {...rest}>
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-0.5">
          →
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={classes} {...rest}>
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-0.5">
          →
        </span>
      )}
    </button>
  )
}
