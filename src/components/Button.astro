---
/**
 * Polymorphic button/link. Renders an <a> when `href` is set, otherwise a
 * <button>. `arrow` appends a small glyph that shifts on hover/focus —
 * the site's one recurring micro-interaction for calls to action.
 */
interface Props {
  href?: string;
  variant?: 'primary' | 'accent' | 'secondary' | 'ghost';
  type?: 'button' | 'submit' | 'reset';
  arrow?: boolean;
  /** Opens in a new tab with rel="noopener noreferrer" — for links off-site. */
  external?: boolean;
  class?: string;
}

const {
  href,
  variant = 'primary',
  type = 'button',
  arrow = false,
  external = false,
  class: className = '',
} = Astro.props;

const base =
  'group/btn inline-flex items-center justify-center gap-2 px-5 py-2.5 text-sm font-medium tracking-wide transition-colors duration-(--duration-fast) focus-visible:outline-2 focus-visible:outline-offset-2';

const variants: Record<string, string> = {
  primary: 'bg-ink-950 text-paper hover:bg-accent',
  accent: 'bg-accent text-paper hover:bg-accent-ink',
  secondary: 'border border-ink-950 text-ink-950 hover:border-accent hover:text-accent-ink',
  ghost: 'text-ink-950 hover:text-accent-ink',
};

const classes = [base, variants[variant], className].join(' ');
---

{
  href ? (
    <a href={href} class={classes} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined}>
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-0.5">
          →
        </span>
      )}
    </a>
  ) : (
    <button type={type} class={classes}>
      <slot />
      {arrow && (
        <span aria-hidden="true" class="transition-transform duration-(--duration-fast) group-hover/btn:translate-x-0.5">
          →
        </span>
      )}
    </button>
  )
}
