---
/**
 * Content-width wrapper + vertical rhythm, with an optional section header
 * (number, kicker, heading, meta). `tone`:
 *   dark   charcoal, the brand's default surface
 *   paper  ivory, for reading and for rhythm between dark bands
 *   dim    a slightly deeper ivory
 *   navy   older name for dark
 * Headings may contain one `*word*`: it gets the bronze accent bar, as in
 * the Shorts.
 */
interface Props {
  as?: 'section' | 'div' | 'header' | 'footer';
  id?: string;
  number?: string;
  kicker?: string;
  heading?: string;
  meta?: string;
  tone?: 'dark' | 'paper' | 'dim' | 'navy';
  width?: 'content' | 'wide';
  class?: string;
  reveal?: boolean;
  /** Kept for older callers; no texture in Milad Style. */
  field?: boolean;
}

const {
  as: Tag = 'section',
  id,
  number,
  kicker,
  heading,
  meta,
  tone: toneProp = 'paper',
  width = 'content',
  class: className = '',
  reveal = false,
} = Astro.props;

const tone = toneProp === 'navy' ? 'dark' : toneProp;
const dark = tone === 'dark';
const toneClasses: Record<string, string> = {
  dark: 'bg-ink text-paper',
  paper: 'on-paper bg-paper text-ink',
  dim: 'on-paper bg-paper-dim text-ink',
};
const widthClass = width === 'wide' ? 'max-w-(--container-wide)' : 'max-w-(--container-content)';

// "*word*" in a heading becomes the accent-underlined word.
const parts: string[] = heading ? heading.split(/\*(.+?)\*/) : [];
---

<Tag id={id} class={`${toneClasses[tone]}${id ? ' scroll-mt-24' : ''}`} {...reveal ? { 'data-reveal': '' } : {}}>
  <div class={`relative mx-auto ${widthClass} px-5 py-16 sm:px-8 lg:py-24 ${className}`}>
    {(kicker || heading || number) && (
      <div class={`mb-10 flex items-start gap-5 lg:mb-14 lg:gap-8`}>
        {number && (
          <span class={`shrink-0 pt-1 font-display text-sm leading-none font-extrabold ${dark ? 'text-accent' : 'text-accent-ink'}`}>
            {number}
          </span>
        )}
        <div class="min-w-0 flex-1">
          {kicker && <p class={`label mb-4 ${dark ? 'text-accent' : 'text-accent-ink'}`}>{kicker}</p>}
          {heading && (
            <h2 class="max-w-3xl font-display text-[2rem] leading-[1.06] font-extrabold tracking-[-0.035em] sm:text-[2.6rem]">
              {parts.map((part, i) => (i % 2 === 1 ? <span class="accent-u">{part}</span> : part))}
            </h2>
          )}
          {meta && <p class={`label mt-4 ${dark ? 'text-on-dark-muted' : 'text-meta'}`}>{meta}</p>}
        </div>
      </div>
    )}
    <slot />
  </div>
</Tag>
