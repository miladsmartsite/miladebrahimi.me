---
/**
 * Consistent content-width wrapper + vertical rhythm for page sections.
 * Supports an editorial "kicker" label above the heading and a `tone` to
 * alternate section backgrounds for visual rhythm without resorting to
 * card borders everywhere.
 */
interface Props {
  as?: 'section' | 'div' | 'header' | 'footer';
  kicker?: string;
  heading?: string;
  tone?: 'paper' | 'dim' | 'ink';
  width?: 'content' | 'wide';
  class?: string;
  reveal?: boolean;
}

const {
  as: Tag = 'section',
  kicker,
  heading,
  tone = 'paper',
  width = 'content',
  class: className = '',
  reveal = false,
} = Astro.props;

const toneClasses: Record<string, string> = {
  paper: 'bg-paper text-ink-950',
  dim: 'bg-paper-dim text-ink-950',
  ink: 'bg-ink-950 text-paper',
};

// Both full class strings must appear literally (not interpolated) so
// Tailwind's static scanner picks them up.
const widthClass = width === 'wide' ? 'max-w-(--container-wide)' : 'max-w-(--container-content)';
---

<Tag class={toneClasses[tone]} {...reveal ? { 'data-reveal': '' } : {}}>
  <div class={`mx-auto ${widthClass} px-6 py-20 sm:px-8 lg:py-28 ${className}`}>
    {(kicker || heading) && (
      <div class="mb-10 lg:mb-14">
        {kicker && (
          <p class="mb-3 font-sans text-xs font-semibold tracking-[0.14em] text-accent uppercase">
            {kicker}
          </p>
        )}
        {heading && (
          <h2 class="max-w-(--container-prose) font-display text-3xl leading-[1.15] font-medium text-balance sm:text-4xl">
            {heading}
          </h2>
        )}
      </div>
    )}
    <slot />
  </div>
</Tag>
