---
/**
 * Honest, in-UI marker for demo/placeholder content (content.placeholder
 * === true in a collection entry) — distinct from `draft`, which hides an
 * entry entirely. Thin wrapper around StatusTag so every "is this real"
 * marker on the site shares one visual vocabulary.
 */
import StatusTag from '@components/StatusTag.astro';

interface Props {
  class?: string;
}

const { class: className = '' } = Astro.props;
---

<StatusTag status="in-development" class={className} />
