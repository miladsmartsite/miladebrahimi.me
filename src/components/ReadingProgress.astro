---
/**
 * A 2px brass line under the header tracking scroll position through the
 * article — the one piece of "how far am I" feedback this phase asks
 * for, and nothing more (Phase 9 §10). rAF-throttled scroll listener,
 * no library. Reduced-motion is already handled globally (global.css
 * zeroes every transition-duration under prefers-reduced-motion), so
 * this component doesn't need its own check.
 */
---

<div
  id="reading-progress"
  class="pointer-events-none fixed inset-x-0 top-0 z-50 h-[2px] origin-left scale-x-0 bg-accent transition-transform duration-100 ease-linear"
  role="presentation"
  aria-hidden="true"
></div>

<script>
  const bar = document.getElementById('reading-progress');
  const article = document.querySelector('article');
  if (bar && article) {
    let ticking = false;
    const update = () => {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      const scrolled = Math.min(Math.max(-rect.top, 0), Math.max(total, 0));
      const ratio = total > 0 ? scrolled / total : 0;
      bar.style.transform = `scaleX(${ratio})`;
      ticking = false;
    };
    update();
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          requestAnimationFrame(update);
          ticking = true;
        }
      },
      { passive: true },
    );
    window.addEventListener('resize', update, { passive: true });
  }
</script>
