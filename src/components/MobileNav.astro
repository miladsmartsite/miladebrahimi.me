---
/**
 * Full-screen mobile navigation — a premium navy/gold overlay rather than
 * a collapsed desktop menu. Covers: a real 44×44px touch target, animated
 * icon morph, body scroll lock, Escape-to-close, click-link-to-close,
 * aria-expanded, and a focus trap while open (Tab/Shift+Tab cycle inside
 * the panel; focus returns to the toggle button on close).
 */
import { NAV_ITEMS, SITE } from '@lib/site';
import Wordmark from '@components/Wordmark.astro';
---

<div class="md:hidden">
  <button
    id="mobile-nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    class="relative z-50 flex size-11 items-center justify-center text-ink"
  >
    <span class="sr-only">Toggle menu</span>
    <span class="relative size-6" aria-hidden="true">
      <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute inset-0 size-6 transition-all duration-(--duration-fast)">
        <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
      </svg>
      <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="absolute inset-0 size-6 scale-50 opacity-0 transition-all duration-(--duration-fast)">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
      </svg>
    </span>
  </button>

  <nav
    id="mobile-nav-panel"
    hidden
    aria-label="Mobile"
    class="fixed inset-0 z-40 flex flex-col bg-ink px-6 pt-8 pb-10 opacity-0 transition-opacity duration-(--duration-base)"
  >
    <a href="/" aria-label="Home" class="shrink-0">
      <Wordmark size="small" reversed />
    </a>
    <div class="flex flex-1 flex-col justify-between pt-10">
      <ul class="flex flex-col gap-1">
        {NAV_ITEMS.map((item, index) => (
          <li
            class="mobile-nav-item translate-y-3 opacity-0 transition-all duration-(--duration-base)"
            style={`transition-delay: ${index * 60}ms`}
          >
            <a href={item.href} class="block border-b border-on-dark-line py-4 font-display text-4xl font-semibold text-paper transition-colors hover:text-accent">
              {item.label}
            </a>
          </li>
        ))}
      </ul>
      <div class="flex flex-col gap-4">
        <a
          href={SITE.cvUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex w-fit items-center gap-2 border border-accent px-4 py-2 font-mono text-[13px] font-medium text-accent transition-colors hover:bg-accent hover:text-ink"
        >
          Download CV
        </a>
        <a href="/contact" class="font-body text-base text-on-dark-muted">
          Prefer email? <span class="text-accent underline">Get in touch →</span>
        </a>
      </div>
    </div>
  </nav>
</div>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const items = document.querySelectorAll<HTMLElement>('.mobile-nav-item');
  let closeTimer: number | undefined;

  function getFocusable(): HTMLElement[] {
    if (!panel) return [];
    return Array.from(
      panel.querySelectorAll<HTMLElement>('a[href], button:not([disabled])'),
    );
  }

  function trapFocus(event: KeyboardEvent) {
    if (event.key !== 'Tab') return;
    const focusable = getFocusable();
    if (focusable.length === 0) return;
    const first = focusable[0];
    const last = focusable[focusable.length - 1];

    if (event.shiftKey && document.activeElement === first) {
      event.preventDefault();
      last.focus();
    } else if (!event.shiftKey && document.activeElement === last) {
      event.preventDefault();
      first.focus();
    }
  }

  function setOpen(isOpen: boolean) {
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    window.clearTimeout(closeTimer);
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen.classList.toggle('opacity-0', isOpen);
    iconOpen.classList.toggle('scale-50', isOpen);
    iconClose.classList.toggle('opacity-0', !isOpen);
    iconClose.classList.toggle('scale-50', !isOpen);

    if (isOpen) {
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      // Force a reflow between un-hiding and the class change below, so the
      // browser commits the "hidden" removal first and the opacity/translate
      // transitions actually animate instead of jumping straight to the end
      // state. (More reliable across environments than requestAnimationFrame.)
      void panel.offsetHeight;
      panel.classList.remove('opacity-0');
      panel.classList.add('opacity-100');
      items.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-3');
        item.classList.add('opacity-100', 'translate-y-0');
      });
      document.addEventListener('keydown', trapFocus);
      // Focus the first nav link, not the wordmark above it — the logo is
      // still reachable via Shift+Tab, but the nav items are the point of
      // opening this panel.
      (panel.querySelector<HTMLElement>('.mobile-nav-item a') ?? getFocusable()[0])?.focus();
    } else {
      panel.classList.remove('opacity-100');
      panel.classList.add('opacity-0');
      items.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-3');
        item.classList.remove('opacity-100', 'translate-y-0');
      });
      document.body.style.overflow = '';
      document.removeEventListener('keydown', trapFocus);
      closeTimer = window.setTimeout(() => {
        panel.hidden = true;
      }, 300);
      toggle.focus();
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape' && toggle?.getAttribute('aria-expanded') === 'true') {
      setOpen(false);
    }
  });
</script>
