---
import { NAV_ITEMS } from '@lib/site';
---

<div class="md:hidden">
  <button
    id="mobile-nav-toggle"
    type="button"
    aria-expanded="false"
    aria-controls="mobile-nav-panel"
    class="relative z-50 p-2 text-ink-950"
  >
    <span class="sr-only">Toggle menu</span>
    <svg id="icon-open" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="size-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M3.75 6.75h16.5M3.75 12h16.5M3.75 17.25h16.5" />
    </svg>
    <svg id="icon-close" xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" class="hidden size-6">
      <path stroke-linecap="round" stroke-linejoin="round" d="M6 18 18 6M6 6l12 12" />
    </svg>
  </button>

  <nav
    id="mobile-nav-panel"
    hidden
    aria-label="Mobile"
    class="fixed inset-0 z-40 flex flex-col justify-between bg-paper px-6 pt-24 pb-10 opacity-0 transition-opacity duration-(--duration-base)"
  >
    <ul class="flex flex-col gap-1">
      {NAV_ITEMS.map((item, index) => (
        <li
          class="mobile-nav-item translate-y-3 opacity-0 transition-all duration-(--duration-base)"
          style={`transition-delay: ${index * 60}ms`}
        >
          <a href={item.href} class="block border-b border-ink-100 py-4 font-display text-4xl text-ink-950">
            {item.label}
          </a>
        </li>
      ))}
    </ul>
    <a href="/contact" class="text-sm text-ink-500">
      Prefer email? <span class="text-accent-ink underline">Get in touch →</span>
    </a>
  </nav>
</div>

<script>
  const toggle = document.getElementById('mobile-nav-toggle');
  const panel = document.getElementById('mobile-nav-panel');
  const iconOpen = document.getElementById('icon-open');
  const iconClose = document.getElementById('icon-close');
  const items = document.querySelectorAll<HTMLElement>('.mobile-nav-item');
  let closeTimer: number | undefined;

  function setOpen(isOpen: boolean) {
    if (!toggle || !panel || !iconOpen || !iconClose) return;
    window.clearTimeout(closeTimer);
    toggle.setAttribute('aria-expanded', String(isOpen));
    iconOpen.classList.toggle('hidden', isOpen);
    iconClose.classList.toggle('hidden', !isOpen);

    if (isOpen) {
      panel.hidden = false;
      document.body.style.overflow = 'hidden';
      // Force a reflow between un-hiding and the class change below, so the
      // browser commits the "hidden" removal first and the opacity/translate
      // transitions actually animate instead of jumping straight to the end
      // state. (More reliable across environments than requestAnimationFrame.)
      void panel.offsetHeight;
      panel.classList.remove('opacity-0');
      panel.classList.add('opacity-100');
      items.forEach((item) => {
        item.classList.remove('opacity-0', 'translate-y-3');
        item.classList.add('opacity-100', 'translate-y-0');
      });
    } else {
      panel.classList.remove('opacity-100');
      panel.classList.add('opacity-0');
      items.forEach((item) => {
        item.classList.add('opacity-0', 'translate-y-3');
        item.classList.remove('opacity-100', 'translate-y-0');
      });
      document.body.style.overflow = '';
      closeTimer = window.setTimeout(() => {
        panel.hidden = true;
      }, 300);
    }
  }

  toggle?.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    setOpen(!isOpen);
  });

  panel?.querySelectorAll('a').forEach((link) => {
    link.addEventListener('click', () => setOpen(false));
  });

  document.addEventListener('keydown', (event) => {
    if (event.key === 'Escape') setOpen(false);
  });
</script>
