---
import { SITE } from '@lib/site';

interface Props {
  title: string;
  description?: string;
  /** Absolute or root-relative path to a social preview image. */
  image?: string;
  /** Defaults to the current page URL. */
  canonicalURL?: string | URL;
  type?: 'website' | 'article';
  noindex?: boolean;
}

const {
  title,
  description = SITE.defaultDescription,
  image = SITE.defaultOgImage,
  canonicalURL = Astro.url,
  type = 'website',
  noindex = false,
} = Astro.props;

// The homepage passes its full "Milad Ebrahimi — ..." title as-is; every
// other page passes just its own name and gets " — Milad Ebrahimi"
// appended. Checking for the name already being present (rather than
// exact equality) keeps this working for both without a special case.
const pageTitle = title.includes(SITE.name) ? title : `${title} — ${SITE.name}`;
const resolvedImage = image ? new URL(image, Astro.site) : undefined;
---

<title>{pageTitle}</title>
<meta name="description" content={description} />
<link rel="canonical" href={canonicalURL} />
{noindex && <meta name="robots" content="noindex, nofollow" />}

<!-- Open Graph -->
<meta property="og:type" content={type} />
<meta property="og:title" content={pageTitle} />
<meta property="og:description" content={description} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:site_name" content={SITE.name} />
{resolvedImage && <meta property="og:image" content={resolvedImage.toString()} />}

<!-- Twitter -->
<meta name="twitter:card" content={resolvedImage ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={pageTitle} />
<meta name="twitter:description" content={description} />
{resolvedImage && <meta name="twitter:image" content={resolvedImage.toString()} />}
