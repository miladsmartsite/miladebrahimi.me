---
/**
 * The arrival block at the top of every inner page. Charcoal by default,
 * like the channel; `*word*` in the title gets the bronze accent bar.
 */
interface Props {
  kicker: string;
  title: string;
  subtitle?: string;
  tone?: 'dark' | 'paper' | 'navy';
}

const { kicker, title, subtitle, tone: toneProp = 'dark' } = Astro.props;
const dark = toneProp !== 'paper';
const parts = title.split(/\*(.+?)\*/);
---

<div class:list={[dark ? 'bg-ink text-paper' : 'on-paper bg-paper text-ink', 'border-b', dark ? 'border-on-dark-line' : 'border-line']}>
  <div class="mx-auto max-w-(--container-content) px-5 pt-14 pb-14 sm:px-8 sm:pt-20 sm:pb-18">
    <p class:list={['label mb-5', dark ? 'text-accent' : 'text-accent-ink']}>{kicker}</p>
    <h1 class="max-w-4xl font-display text-[2.6rem] leading-[1.02] font-extrabold tracking-[-0.045em] sm:text-6xl lg:text-[4.25rem]">
      {parts.map((part, i) => (i % 2 === 1 ? <span class="accent-u">{part}</span> : part))}
    </h1>
    {subtitle && <p class:list={['mt-6 max-w-2xl text-lg leading-relaxed sm:text-xl', dark ? 'text-on-dark-muted' : 'text-body']}>{subtitle}</p>}
    <slot />
  </div>
</div>
