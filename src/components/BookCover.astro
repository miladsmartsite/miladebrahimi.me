---
/**
 * Book cover. Shows the real cover image when one exists in public/;
 * otherwise a typographic cover in the brand (charcoal, title in Manrope,
 * the bronze bar), never a fake mock-up of the printed book.
 */
import fs from 'node:fs';
import path from 'node:path';

interface Props {
  title: string;
  subtitle?: string;
  src?: string;
  meta?: string;
  class?: string;
}

const { title, subtitle, src, meta, class: className = '' } = Astro.props;
const exists = src ? fs.existsSync(path.join(process.cwd(), 'public', src)) : false;
---

<div class={`relative aspect-[2/3] w-full overflow-hidden border border-on-dark-line bg-ink-soft ${className}`}>
  {exists ? (
    <img src={src} alt={`Cover of ${title}`} loading="lazy" class="h-full w-full object-cover" />
  ) : (
    <div class="flex h-full flex-col justify-between p-[9%] text-paper">
      <p class="label text-[10px] text-on-dark-muted">Milad Ebrahimi</p>
      <div>
        <p class="font-display text-[clamp(1.1rem,3.2vw,1.65rem)] leading-[1.02] font-extrabold tracking-[-0.04em]">{title}</p>
        <span class="mt-4 block h-[3px] w-8 bg-accent"></span>
        {subtitle && <p class="mt-4 text-[11px] leading-snug text-on-dark-muted">{subtitle}</p>}
      </div>
      <p class="label text-[10px] text-accent">{meta ?? ''}</p>
    </div>
  )}
</div>
