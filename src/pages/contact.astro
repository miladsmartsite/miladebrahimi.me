---
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import { SITE, CONTACT_TOPICS } from '@lib/site';
---

<BaseLayout
  title="Contact"
  description="Get in touch about a system worth building, a problem worth untangling, or a conversation worth having."
>
  <Section kicker="Contact" heading="Let's talk." reveal>
    <p class="max-w-(--container-prose) text-lg text-ink-700">
      If you're building something, fixing something, or trying to make the work work better —
      reach out. A short note is enough to start.
    </p>

    <p class="mt-8 max-w-(--container-prose) text-sm text-ink-500">
      Open to conversations around:
    </p>
    <ul class="mt-3 flex max-w-2xl flex-wrap gap-x-4 gap-y-2">
      {CONTACT_TOPICS.map((topic) => (
        <li class="text-xs font-medium tracking-wide text-ink-700 uppercase">{topic}</li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap items-center gap-4">
      <Button href={`mailto:${SITE.contactEmail}`} variant="accent" arrow>
        {SITE.contactEmail}
      </Button>
      <Button href="https://www.linkedin.com/in/miladebrahimi-me" variant="secondary" arrow external>
        Connect on LinkedIn
      </Button>
    </div>
  </Section>
</BaseLayout>
