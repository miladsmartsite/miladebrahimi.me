---
/**
 * Contact: a short invitation and the real channels. No form, because there
 * is no backend to receive one.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import { SITE, CONTACT_TOPICS, YOUTUBE } from '@lib/site';

const channels = [
  { label: 'Email', value: SITE.contactEmail, href: `mailto:${SITE.contactEmail}`, external: false },
  { label: 'LinkedIn', value: 'in/miladebrahimi-me', href: 'https://www.linkedin.com/in/miladebrahimi-me', external: true },
  { label: 'YouTube', value: YOUTUBE.handle, href: YOUTUBE.url, external: true },
];
---

<BaseLayout title="Contact" description="Contact Milad Ebrahimi about coaching, workshops for teams, speaking, interviews or the books.">
  <PageHero
    kicker="Contact"
    title="Write to me. A short note is *enough.*"
    subtitle="I read every message myself. Tell me who you are and what you have in mind, and I'll reply."
  />

  <Section tone="paper">
    <p class="label text-accent-ink">Good reasons to write</p>
    <ul class="mt-4 flex flex-wrap gap-2">
      {CONTACT_TOPICS.map((topic) => (
        <li class="border border-line px-3 py-2 text-[15px] text-body">{topic}</li>
      ))}
    </ul>

    <dl class="mt-12 grid border-t-2 border-ink sm:grid-cols-3">
      {channels.map((c, i) => (
        <div class:list={['py-6 sm:pr-6', i > 0 ? 'border-t border-line sm:border-t-0 sm:border-l sm:pl-6' : '']}>
          <dt class="label text-accent-ink">{c.label}</dt>
          <dd class="mt-2">
            <a href={c.href} target={c.external ? '_blank' : undefined} rel={c.external ? 'noopener noreferrer' : undefined} class="flex min-h-11 items-center text-lg break-all text-ink underline decoration-line decoration-2 underline-offset-4 hover:decoration-accent-ink">
              {c.value}
            </a>
          </dd>
        </div>
      ))}
    </dl>

    <div class="mt-12 flex flex-wrap gap-3">
      <Button href={`mailto:${SITE.contactEmail}`} variant="dark" arrow data-cta="contact-email">Email Milad</Button>
      <Button href="/coaching/" variant="ghost" arrow data-cta="contact-coaching">Coaching and workshops</Button>
    </div>
  </Section>
</BaseLayout>
