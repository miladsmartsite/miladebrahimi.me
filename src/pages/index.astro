---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import SystemCard from '@components/SystemCard.astro';
import Positioning from '@components/home/Positioning.astro';
import HowIWork from '@components/home/HowIWork.astro';
import AreasOfWork from '@components/home/AreasOfWork.astro';
import Career from '@components/home/Career.astro';
import Results from '@components/home/Results.astro';
import BooksShowcase from '@components/home/BooksShowcase.astro';
import AboutTeaser from '@components/home/AboutTeaser.astro';
import SpeakingTopics from '@components/home/SpeakingTopics.astro';
import FinalCta from '@components/home/FinalCta.astro';
import { SITE, HOME } from '@lib/site';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const systems = allProjects.sort((a, b) => a.data.order - b.data.order);

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const ideas = allArticles
  .sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf())
  .slice(0, 3);

const allBooks = await getCollection('books', ({ data }) => !data.draft);
const books = allBooks.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={SITE.name}>
  <Hero
    eyebrow={HOME.hero.eyebrow}
    title={HOME.hero.headline}
    subtitle={HOME.hero.subhead}
    note={HOME.hero.note}
  >
    <Button href="/projects" variant="accent" arrow>See the systems</Button>
    <Button href="/contact" variant="ghost">Get in touch →</Button>
  </Hero>

  <Positioning
    kicker={HOME.idea.kicker}
    statement={HOME.idea.heading}
    body={HOME.idea.body}
  />

  <Section kicker={HOME.systems.kicker} heading={HOME.systems.heading} tone="paper" reveal>
    <div>
      {systems.map((project, index) => (
        <SystemCard project={project} index={index} />
      ))}
    </div>
    <p class="mt-8 max-w-2xl text-xs text-ink-500">{HOME.systems.note}</p>
  </Section>

  <HowIWork />

  <AreasOfWork />

  <Career />

  <Results />

  {ideas.length > 0 && (
    <Section kicker={HOME.ideas.kicker} heading={HOME.ideas.heading} tone="paper" reveal>
      <p class="mb-6 max-w-2xl text-sm text-ink-500 italic">{HOME.ideas.note}</p>
      <ul class="max-w-(--container-prose) divide-y divide-ink-100 border-t border-ink-100">
        {ideas.map((article) => (
          <li class="py-5">
            <h3 class="font-display text-lg text-ink-950">{article.data.title}</h3>
            <p class="mt-1.5 text-sm text-ink-700">{article.data.description}</p>
          </li>
        ))}
      </ul>
      <div class="mt-8">
        <Button href="/articles" variant="secondary" arrow>See all topics</Button>
      </div>
    </Section>
  )}

  {books.length > 0 && <BooksShowcase books={books} />}

  <AboutTeaser />

  <SpeakingTopics />

  <FinalCta />
</BaseLayout>
