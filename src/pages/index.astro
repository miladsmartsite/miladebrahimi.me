---
/**
 * Homepage — Phase 3 restructure. Eight sections, in this fixed order:
 * Hero → Five Areas → The Milad Method → Selected Work → Proof of Work →
 * Contents → Books → Final CTA. Deliberately NOT the full resume — no
 * career timeline, no skills/education dump; that's all on /resume.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Hero from '@components/Hero.astro';
import Button from '@components/Button.astro';
import ExpertiseAreas from '@components/home/ExpertiseAreas.astro';
import MiladMethod from '@components/home/MiladMethod.astro';
import SystemsArchive from '@components/home/SystemsArchive.astro';
import ProofOfWork from '@components/home/ProofOfWork.astro';
import ContentsPreview from '@components/home/ContentsPreview.astro';
import BooksShowcase from '@components/home/BooksShowcase.astro';
import FinalCta from '@components/home/FinalCta.astro';
import { SITE, HOME, EXPERTISE_AREAS } from '@lib/site';

const allProjects = await getCollection('projects', ({ data }) => !data.draft);
const systems = allProjects.sort((a, b) => a.data.order - b.data.order);

const heroStats = [
  { label: 'Areas of practice', value: String(EXPERTISE_AREAS.length).padStart(2, '0') },
  { label: 'Systems built', value: String(systems.length).padStart(2, '0') },
  { label: 'Base', value: 'Muscat, OM' },
];

const allBooks = await getCollection('books', ({ data }) => !data.draft);
const books = allBooks.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout title={SITE.name} description={SITE.defaultDescription}>
  {/* 01 — Hero */}
  <Hero
    masthead={SITE.brandName}
    eyebrow={HOME.hero.eyebrow}
    title={HOME.hero.headline}
    subtitle={HOME.hero.subhead}
    note={HOME.hero.note}
    stats={heroStats}
  >
    <Button href="/projects" variant="accent" arrow>{HOME.hero.primaryCta}</Button>
    <Button
      href="/resume"
      variant="secondary"
      class="!border-on-dark-line !text-paper hover:!border-accent hover:!text-accent"
    >
      {HOME.hero.secondaryCta}
    </Button>
  </Hero>

  {/* 02 — Five Areas */}
  <ExpertiseAreas />

  {/* 03 — The Milad Method */}
  <MiladMethod />

  {/* 04 — Selected Work */}
  <SystemsArchive systems={systems} />

  {/* 05 — Proof of Work */}
  <ProofOfWork />

  {/* 06 — Contents */}
  <ContentsPreview />

  {/* 07 — Books */}
  {books.length > 0 && <BooksShowcase books={books} />}

  {/* 08 — Final CTA */}
  <FinalCta />
</BaseLayout>
