---
/**
 * No podcast has been recorded yet — an honest "not yet" page rather than
 * a fabricated episode list, consistent with the site's no-fabrication
 * rule. Add a `podcasts` content collection when a real episode exists.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
---

<BaseLayout title="Podcasts" description="Longer-form conversations on operations, systems, and organizational improvement — coming soon.">
  <PageHero kicker="Contents · Podcasts" title="Podcasts." subtitle="Nothing recorded yet — this page is here so the destination exists before the first episode does." />

  <Section reveal>
    <p class="max-w-2xl font-body text-lg text-body">
      No podcast has been published yet. When one exists, it'll be listed here — real episodes
      only, never a placeholder presented as published.
    </p>
    <div class="mt-8">
      <Button href="/contents" variant="secondary" arrow>Back to Contents</Button>
    </div>
  </Section>
</BaseLayout>
