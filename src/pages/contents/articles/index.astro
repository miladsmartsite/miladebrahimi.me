---
/**
 * Ideas = an intellectual archive, not a blog feed: one featured entry,
 * a short "latest" list, then the full archive. Reading time is computed
 * from each entry's real body text — see src/lib/reading-time.ts.
 */
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import ArticleImage from '@components/ArticleImage.astro';
import { readingTime } from '@lib/reading-time';
import { SITE } from '@lib/site';

const allArticles = await getCollection('articles', ({ data }) => !data.draft);
const articles = allArticles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
const [featured, ...rest] = articles;

function formatDate(d: Date) {
  return d.toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contents', item: new URL('/contents', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: 'Articles' },
  ],
};
---

<BaseLayout
  title="Ideas"
  description="Notes on operations, systems, and where AI actually helps — an intellectual archive, not a blog."
  structuredData={breadcrumbSchema}
>
  <PageHero
    kicker="Ideas"
    title="Writing, in progress."
    subtitle="Notes on operations, systems, productivity, and where AI actually helps — published as they're ready, not on a schedule."
  />

  {articles.length > 0 ? (
    <>
      <Section reveal>
        <p class="mb-3 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Featured</p>
        <div class="grid gap-8 border-b border-line pb-12 lg:grid-cols-12 lg:gap-10">
          {featured.data.coverImage && (
            <div class="lg:order-2 lg:col-span-5">
              <ArticleImage src={featured.data.coverImage} title={featured.data.title} />
            </div>
          )}
          <div class:list={['lg:order-1', featured.data.coverImage ? 'lg:col-span-7' : 'lg:col-span-8']}>
            <a href={`/articles/${featured.id}`} class="group/idea block">
              <h2 class="font-display text-3xl leading-tight font-bold tracking-[-0.02em] text-ink transition-colors group-hover/idea:text-accent-ink sm:text-4xl">
                {featured.data.title}
              </h2>
              <p class="mt-4 max-w-xl font-body text-lg text-body">{featured.data.description}</p>
            </a>
            <div class="mt-5 flex flex-wrap items-center gap-4 font-mono text-[11px] tracking-wide text-meta uppercase">
              <time datetime={featured.data.publishDate.toISOString()}>{formatDate(featured.data.publishDate)}</time>
              <span>{readingTime(featured.body ?? '')}</span>
              {featured.data.tags[0] && <span>{featured.data.tags[0]}</span>}
              {featured.data.placeholder && <PlaceholderTag />}
            </div>
          </div>
        </div>
      </Section>

      {rest.length > 0 && (
        <Section kicker="Archive" heading="More writing." tone="dim" reveal>
          <ol class="divide-y divide-line border-t border-line">
            {rest.map((article) => (
              <li class="group/row py-6">
                <a href={`/articles/${article.id}`} class="block">
                  <div class="flex flex-wrap items-center gap-3 font-mono text-[11px] tracking-wide text-meta uppercase">
                    <time datetime={article.data.publishDate.toISOString()}>{formatDate(article.data.publishDate)}</time>
                    <span>{readingTime(article.body ?? '')}</span>
                    {article.data.tags[0] && <span>{article.data.tags[0]}</span>}
                    {article.data.placeholder && <PlaceholderTag />}
                  </div>
                  <h3 class="mt-2 font-display text-xl font-bold tracking-[-0.02em] text-ink transition-colors group-hover/row:text-accent-ink">
                    {article.data.title}
                  </h3>
                  <p class="mt-1.5 max-w-2xl font-body text-base text-body">{article.data.description}</p>
                </a>
              </li>
            ))}
          </ol>
        </Section>
      )}
    </>
  ) : (
    <Section reveal>
      <p class="font-body text-lg text-body">
        [PLACEHOLDER] No published articles yet. Add markdown files to
        <code>src/content/articles/</code> and set <code>draft: false</code>.
      </p>
    </Section>
  )}
</BaseLayout>
