---
/**
 * Article detail — Phase 9's premium editorial reading experience.
 * Structure follows the brief's own hierarchy exactly: context → title →
 * description → byline meta → cover → TOC → body → tags → author block →
 * related → prev/next → final CTA. Prose is capped at --container-prose
 * (42rem ≈ 70 characters per line) for comfortable reading; the page
 * itself can be wider (metadata, TOC, related rows) without the actual
 * running text ever stretching past that.
 */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import ArticleImage from '@components/ArticleImage.astro';
import QuoteBlock from '@components/QuoteBlock.astro';
import VideoFeature from '@components/VideoFeature.astro';
import MetaRow from '@components/MetaRow.astro';
import TableOfContents from '@components/TableOfContents.astro';
import ReadingProgress from '@components/ReadingProgress.astro';
import ShareLinks from '@components/ShareLinks.astro';
import AuthorBlock from '@components/AuthorBlock.astro';
import FinalCta from '@components/home/FinalCta.astro';
import { readingTime } from '@lib/reading-time';
import { SITE, EXPERTISE_AREAS, PERSON_ID } from '@lib/site';

export async function getStaticPaths() {
  const articles = await getCollection('articles', ({ data }) => !data.draft);
  const sorted = articles.sort((a, b) => b.data.publishDate.valueOf() - a.data.publishDate.valueOf());
  return sorted.map((article, i) => ({
    params: { slug: article.id },
    props: {
      article,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
      related: sorted.filter((_, j) => j !== i),
    },
  }));
}

const { article, prev, next, related } = Astro.props;
const { Content, headings } = await render(article);
const formattedDate = article.data.publishDate.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
const minutesRead = readingTime(article.body ?? '');

// Related Expertise / Related Work (Phase 10 §23) — the article's own
// `category` field IS one of the five area titles, so this is a direct
// lookup, not a guess; Related Work reuses that area's already-defined
// `relatedTags` (the same relationship the Expertise Matrix itself uses)
// rather than matching on the article's tags, which would risk pulling in
// projects on a loose keyword coincidence.
const relatedArea = EXPERTISE_AREAS.find((a) => a.title === article.data.category);
const relatedProjects = relatedArea
  ? (await getCollection('projects', ({ data }) => !data.draft))
      .filter((p) => p.data.tags.some((t) => relatedArea.relatedTags.includes(t)))
      .sort((a, b) => a.data.order - b.data.order)
      .slice(0, 2)
  : [];

// A short piece with one or two headings doesn't need a map — the TOC
// only earns its place once there's real structure to navigate (Phase 9 §09).
const tocHeadings = headings.filter((h) => h.depth === 2 || h.depth === 3);
const showToc = tocHeadings.length >= 3;

// Ranked, not just filtered: same category outranks a shared tag, more
// shared tags outrank fewer, and recency breaks any remaining tie —
// matching Phase 8 §14's signal priority without a recommendation engine.
const rankedRelated = related
  .map((r) => {
    const sharedTags = r.data.tags.filter((t) => article.data.tags.includes(t)).length;
    const sameCategory = r.data.category === article.data.category;
    if (!sameCategory && sharedTags === 0) return null;
    return { entry: r, score: (sameCategory ? 100 : 0) + sharedTags };
  })
  .filter((x): x is { entry: (typeof related)[number]; score: number } => x !== null)
  .sort((a, b) => b.score - a.score || b.entry.data.publishDate.valueOf() - a.entry.data.publishDate.valueOf())
  .slice(0, 3)
  .map((x) => x.entry);

// Phase 11 — a one-shot "reached the end of the piece" signal rather than
// continuous scroll tracking (§8: "do NOT implement invasive scroll
// tracking"). Gated on the same env var as Analytics.astro so a page with
// analytics disabled ships zero extra script for this.
const analyticsEnabled = Boolean(import.meta.env.PUBLIC_UMAMI_WEBSITE_ID);

const pageUrl = new URL(Astro.url.pathname, SITE.url).toString();
const coverExists = article.data.coverImage
  ? fs.existsSync(path.join(process.cwd(), 'public', article.data.coverImage))
  : false;

const articleSchema = {
  '@type': 'Article',
  headline: article.data.title,
  description: article.data.description,
  datePublished: article.data.publishDate.toISOString(),
  ...(article.data.updatedDate ? { dateModified: article.data.updatedDate.toISOString() } : {}),
  // References the sitewide Person node by @id rather than re-declaring a
  // same-named Person object — every real article today is authored by
  // Milad, so this connects Article -> Author -> the one canonical Person
  // entity (Phase 16 §4). A genuine future guest byline (author !==
  // SITE.name) falls back to its own plain Person object instead.
  author: article.data.author === SITE.name ? { '@id': PERSON_ID } : { '@type': 'Person', name: article.data.author },
  mainEntityOfPage: pageUrl,
  ...(coverExists ? { image: new URL(article.data.coverImage!, SITE.url).toString() } : {}),
};

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Contents', item: new URL('/contents', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: 'Articles', item: new URL('/contents/articles', SITE.url).toString() },
    { '@type': 'ListItem', position: 4, name: article.data.title },
  ],
};
---

<BaseLayout
  title={article.data.title}
  description={article.data.description}
  image={coverExists ? article.data.coverImage : undefined}
  type="article"
  noindex={article.data.placeholder}
  structuredData={[articleSchema, breadcrumbSchema]}
>
  <ReadingProgress />

  <article>
    <Section>
      <p class="font-mono text-[11px] tracking-wide text-meta uppercase">
        <a href="/contents" class="hover:text-accent-ink">Contents</a>
        <span aria-hidden="true"> / </span>
        <a href="/contents/articles" class="hover:text-accent-ink">Articles</a>
      </p>

      <p class="mt-6 font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">
        Article / {article.data.category}
      </p>
      <h1 class="mt-3 max-w-3xl font-display text-4xl leading-[1.05] font-bold tracking-[-0.03em] text-ink text-balance sm:text-5xl lg:text-[3.25rem]">
        {article.data.title}
      </h1>
      <p class="mt-5 max-w-2xl font-body text-xl text-body">{article.data.description}</p>

      <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-line pt-6">
        <ul class="flex flex-wrap items-center gap-x-6 gap-y-1 font-mono text-[11px] tracking-wide text-meta uppercase">
          <li>{article.data.author}</li>
          <li><time datetime={article.data.publishDate.toISOString()}>{formattedDate}</time></li>
          <li>{minutesRead}</li>
        </ul>
        {article.data.placeholder && <PlaceholderTag />}
      </div>

      <div class="mt-4">
        <ShareLinks url={pageUrl} title={article.data.title} />
      </div>

      {article.data.coverImage && (
        <ArticleImage src={article.data.coverImage} title={article.data.title} class="mt-10 max-w-(--container-prose)" />
      )}

      <div class="mt-10 max-w-(--container-prose) border-t border-line pt-8">
        {showToc && <TableOfContents headings={headings} />}

        <div class="prose prose-lg font-body text-body">
          <Content />
        </div>

        {article.data.quote && <QuoteBlock class="mt-10">{article.data.quote}</QuoteBlock>}

        {article.data.videoUrl && (
          <VideoFeature
            title={`Watch: ${article.data.title}`}
            category={article.data.category}
            url={article.data.videoUrl}
            class="mt-10"
          />
        )}

        {article.data.tags.length > 0 && (
          <ul class="mt-10 flex flex-wrap gap-2 border-t border-line pt-8">
            {article.data.tags.map((tag) => (
              <li class="border border-line px-2.5 py-1 font-mono text-[10px] tracking-wide text-body uppercase">{tag}</li>
            ))}
          </ul>
        )}

        {relatedArea && (
          <div class="mt-10 flex flex-wrap gap-3 border-t border-line pt-8">
            <a
              href="/expertise#matrix"
              data-cta="article-related-expertise"
              class="inline-flex min-h-11 items-center font-mono text-[13px] font-medium text-accent-ink underline decoration-line underline-offset-4 hover:decoration-accent"
            >
              Related expertise: {relatedArea.title} →
            </a>
            {relatedProjects.map((p) => (
              <a
                href={`/projects/${p.id}`}
                data-cta="article-related-work"
                class="inline-flex min-h-11 items-center font-mono text-[13px] font-medium text-accent-ink underline decoration-line underline-offset-4 hover:decoration-accent"
              >
                Related work: {p.data.title} →
              </a>
            ))}
          </div>
        )}

        <div id="article-engagement-marker" class="mt-10">
          <AuthorBlock />
        </div>
      </div>

      {rankedRelated.length > 0 && (
        <div class="mt-14 max-w-(--container-prose) border-t border-line pt-8">
          <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Related writing</h2>
          <ol class="mt-4 divide-y divide-line border-t border-line">
            {rankedRelated.map((r) => (
              <li class="py-4">
                <a href={`/contents/articles/${r.id}`} class="group/related block">
                  <p class="font-display text-lg font-bold tracking-[-0.01em] text-ink transition-colors group-hover/related:text-accent-ink">
                    {r.data.title}
                  </p>
                  <MetaRow
                    class="mt-1.5"
                    items={[
                      r.data.category,
                      r.data.publishDate.toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' }),
                      readingTime(r.body ?? ''),
                    ]}
                  />
                </a>
              </li>
            ))}
          </ol>
        </div>
      )}

      <nav aria-label="Article navigation" class="mt-10 max-w-(--container-prose) border-t border-line pt-8">
        <div class="grid gap-6 sm:grid-cols-2">
          <div>
            {prev && (
              <a href={`/contents/articles/${prev.id}`} class="group/nav block">
                <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-meta uppercase">← Previous</p>
                <p class="mt-2 font-body text-lg text-ink italic transition-colors group-hover/nav:text-accent-ink">{prev.data.title}</p>
              </a>
            )}
          </div>
          <div class="sm:text-right">
            {next ? (
              <a href={`/contents/articles/${next.id}`} class="group/nav block">
                <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-meta uppercase">Next →</p>
                <p class="mt-2 font-body text-lg text-ink italic transition-colors group-hover/nav:text-accent-ink">{next.data.title}</p>
              </a>
            ) : (
              <a href="/contents/articles" class="group/nav block">
                <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-meta uppercase">More writing →</p>
                <p class="mt-2 font-body text-lg text-ink italic transition-colors group-hover/nav:text-accent-ink">All ideas</p>
              </a>
            )}
          </div>
        </div>
      </nav>
    </Section>
  </article>

  <FinalCta />

  {analyticsEnabled && (
    <script>
      // Reaching this marker (right after the full body, tags, and related
      // links) stands in for "read the piece" without tracking scroll
      // position continuously — one observer, one event, then disconnect.
      const marker = document.getElementById('article-engagement-marker');
      if (marker && 'IntersectionObserver' in window) {
        const observer = new IntersectionObserver((entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              window.umami?.track('article_engagement', { path: location.pathname });
              observer.disconnect();
            }
          }
        }, { threshold: 0.1 });
        observer.observe(marker);
      }
    </script>
  )}
</BaseLayout>
