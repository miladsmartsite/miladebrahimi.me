---
/**
 * 404 = a brand moment, not a dead end — uses the same ghost-numeral and
 * navy-field language as the rest of the site rather than a generic error
 * page.
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
---

<BaseLayout title="System Not Found" noindex>
  <div class="field-grid relative flex min-h-[70vh] flex-col items-start justify-center overflow-hidden bg-ink px-6 py-24 text-paper sm:px-8">
    <p class="relative font-display text-[7rem] leading-none font-extrabold text-accent sm:text-[9rem]">404</p>
    <h1 class="relative mt-2 font-display text-3xl font-bold tracking-[-0.03em] text-paper sm:text-4xl">System not found.</h1>
    <p class="relative mt-4 max-w-md font-body text-lg text-on-dark-muted">
      The page you're looking for doesn't exist or has moved — everything else is still exactly
      where it should be.
    </p>
    <div class="relative mt-8 flex flex-wrap gap-4">
      <Button href="/" variant="accent" arrow>Back home</Button>
      <Button href="/projects" variant="secondary" class="!border-on-dark-line !text-paper hover:!border-accent hover:!text-accent">
        Explore the work
      </Button>
    </div>
  </div>
</BaseLayout>
