---
import BaseLayout from '@layouts/BaseLayout.astro';
import Button from '@components/Button.astro';
---

<BaseLayout title="Page not found" noindex>
  <section class="bg-ink text-paper">
    <div class="mx-auto flex min-h-[60vh] max-w-(--container-content) flex-col justify-center px-5 py-24 sm:px-8">
      <p class="label text-accent">404</p>
      <h1 class="mt-5 max-w-3xl font-display text-[2.8rem] leading-[1.02] font-extrabold tracking-[-0.045em] sm:text-6xl">
        This page has <span class="accent-u">moved.</span>
      </h1>
      <p class="mt-6 max-w-lg text-lg text-on-dark-muted">The site was reorganised, so an old link may point nowhere. Everything is still here.</p>
      <div class="mt-9 flex flex-wrap gap-3">
        <Button href="/" arrow>Home</Button>
        <Button href="/ideas/" variant="secondary">Ideas</Button>
        <Button href="/start/" variant="secondary">Free worksheet</Button>
      </div>
    </div>
  </section>
</BaseLayout>
