---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import Timeline from '@components/Timeline.astro';
import { SITE, CV, RESULTS, HOME } from '@lib/site';

const allExperience = await getCollection('experience', ({ data }) => !data.draft);
const experience = allExperience.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

const allBooks = await getCollection('books', ({ data }) => !data.draft);
const books = allBooks.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="CV"
  description="A digital professional profile — experience, results, skills, education, and languages."
>
  <Section kicker="CV" heading={SITE.name} reveal>
    <p class="max-w-(--container-prose) text-lg text-ink-700">{CV.summary}</p>
    <p class="mt-4 text-xs text-ink-500">
      A downloadable PDF version of this profile isn't available yet — this page is the canonical,
      up-to-date version in the meantime.
    </p>
  </Section>

  <Section kicker="Experience" heading="Career history." tone="dim" reveal>
    <Timeline items={experience} />
  </Section>

  <Section kicker="Results" heading="Measurable results, as stated on the CV." reveal>
    <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
      {RESULTS.map((result) => (
        <div class="border-t-2 border-accent pt-5">
          <p class="font-display text-4xl text-ink-950">{result.metric}</p>
          <p class="mt-3 text-sm text-ink-700">{result.detail}</p>
          <p class="mt-3 text-xs tracking-wide text-ink-500 uppercase">{result.source}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-2xl text-xs text-ink-500 italic">{HOME.results.note}</p>
  </Section>

  <Section kicker="Skills" heading="Skills." tone="dim" reveal>
    <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {CV.skills.map((item) => (
        <li class="border-t border-ink-300 pt-3">
          <p class="text-xs tracking-wide text-accent uppercase">{item.category}</p>
          <p class="mt-1 text-ink-950">{item.skill}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section kicker="Education & Certifications" heading="Education & certifications." reveal>
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h3 class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">Education</h3>
        <ul class="mt-4 space-y-4">
          {CV.education.map((edu) => (
            <li>
              <p class="font-display text-lg text-ink-950">{edu.institution}</p>
              <p class="text-sm text-ink-700">{edu.program}</p>
              <p class="text-xs text-ink-500">{edu.location} · {edu.period}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="text-xs font-semibold tracking-[0.14em] text-accent uppercase">Certifications</h3>
        <ul class="mt-4 space-y-3">
          {CV.certifications.map((cert) => (
            <li class="text-sm text-ink-700">{cert}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {books.length > 0 && (
    <Section kicker="Books" heading="Published books." tone="dim" reveal>
      <ul class="grid gap-6 sm:grid-cols-3">
        {books.map((book) => (
          <li class="border border-ink-300 p-5">
            <p class="text-xs text-ink-500">{book.data.year} · {book.data.language}</p>
            <p class="mt-2 font-display text-lg text-ink-950">{book.data.title}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section kicker="Languages" heading="Languages." reveal>
    <ul class="flex flex-wrap gap-8">
      {CV.languages.map((lang) => (
        <li>
          <p class="font-display text-lg text-ink-950">{lang.language}</p>
          <p class="text-xs text-ink-500">{lang.level}</p>
        </li>
      ))}
    </ul>
  </Section>
</BaseLayout>
