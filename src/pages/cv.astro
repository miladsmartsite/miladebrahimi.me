---
import { getCollection } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import Timeline from '@components/Timeline.astro';
import Button from '@components/Button.astro';
import { SITE, CV, RESULTS, HOME } from '@lib/site';

const allExperience = await getCollection('experience', ({ data }) => !data.draft);
const experience = allExperience.sort(
  (a, b) => b.data.startDate.valueOf() - a.data.startDate.valueOf(),
);

const allBooks = await getCollection('books', ({ data }) => !data.draft);
const books = allBooks.sort((a, b) => a.data.order - b.data.order);
---

<BaseLayout
  title="CV"
  description="A digital professional profile — experience, results, skills, education, and languages."
>
  <PageHero kicker="CV" title={SITE.name} subtitle={CV.summary} />

  <Section reveal>
    <p class="max-w-(--container-prose) font-body text-base text-meta">
      This page complements the PDF rather than duplicating every line of it — full detail, dates,
      and formatting live in the download.
    </p>
    <div class="mt-6">
      <Button href={SITE.cvUrl} variant="accent" external arrow>Download CV</Button>
    </div>
  </Section>

  <Section kicker="Experience" heading="Career history." tone="dim" reveal>
    <Timeline items={experience} />
  </Section>

  <Section kicker="Results" heading="Measurable results, as stated on the CV." reveal>
    <div class="grid gap-8 sm:grid-cols-3 sm:gap-6">
      {RESULTS.map((result) => (
        <div class="border-t-2 border-accent pt-5">
          <p class="font-display text-4xl font-bold text-ink">{result.metric}</p>
          <p class="mt-3 font-body text-base text-body">{result.detail}</p>
          <p class="mt-3 font-mono text-[10px] tracking-wide text-meta uppercase">{result.source}</p>
        </div>
      ))}
    </div>
    <p class="mt-8 max-w-2xl font-body text-sm text-meta italic">{HOME.results.note}</p>
  </Section>

  <Section kicker="Skills" heading="Skills." tone="dim" reveal>
    <ul class="grid gap-x-8 gap-y-4 sm:grid-cols-2">
      {CV.skills.map((item) => (
        <li class="border-t border-line pt-3">
          <p class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">{item.category}</p>
          <p class="mt-1 font-body text-lg text-ink">{item.skill}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section kicker="Education & Certifications" heading="Education & certifications." reveal>
    <div class="grid gap-10 sm:grid-cols-2">
      <div>
        <h3 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Education</h3>
        <ul class="mt-4 space-y-4">
          {CV.education.map((edu) => (
            <li>
              <p class="font-display text-lg font-bold tracking-[-0.02em] text-ink">{edu.institution}</p>
              <p class="font-body text-base text-body">{edu.program}</p>
              <p class="font-mono text-[11px] text-meta">{edu.location} · {edu.period}</p>
            </li>
          ))}
        </ul>
      </div>
      <div>
        <h3 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">Certifications</h3>
        <ul class="mt-4 space-y-3">
          {CV.certifications.map((cert) => (
            <li class="font-body text-base text-body">{cert}</li>
          ))}
        </ul>
      </div>
    </div>
  </Section>

  {books.length > 0 && (
    <Section kicker="Books" heading="Published books." tone="dim" reveal>
      <ul class="grid gap-6 sm:grid-cols-3">
        {books.map((book) => (
          <li class="border border-line p-5">
            <p class="font-mono text-[11px] text-meta">{book.data.year} · {book.data.language}</p>
            <p class="mt-2 font-display text-lg font-bold tracking-[-0.02em] text-ink">{book.data.title}</p>
          </li>
        ))}
      </ul>
    </Section>
  )}

  <Section kicker="Languages" heading="Languages." reveal>
    <ul class="flex flex-wrap gap-8">
      {CV.languages.map((lang) => (
        <li>
          <p class="font-display text-lg font-bold tracking-[-0.02em] text-ink">{lang.language}</p>
          <p class="font-mono text-[11px] text-meta">{lang.level}</p>
        </li>
      ))}
    </ul>
  </Section>

  <Section reveal>
    <div class="flex flex-col items-start gap-6 border-t border-line pt-10 sm:flex-row sm:items-center sm:justify-between">
      <p class="max-w-md font-body text-lg text-body">Want the full PDF, or to talk about any of this directly?</p>
      <div class="flex flex-wrap gap-3">
        <Button href={SITE.cvUrl} variant="accent" external arrow>Download CV</Button>
        <Button href="/contact" variant="ghost" arrow>Get in touch</Button>
      </div>
    </div>
  </Section>
</BaseLayout>
