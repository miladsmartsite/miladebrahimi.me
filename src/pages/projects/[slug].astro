---
/**
 * Case study = a project dossier, not a blog post. Twelve numbered
 * sections (some collapse when a field is genuinely empty — see the Row
 * list below, which keeps numbering sequential regardless of which
 * optional fields exist). Every claim carries an explicit evidence status
 * (§09) rather than presenting everything as equally certain.
 */
import fs from 'node:fs';
import path from 'node:path';
import { getCollection, render } from 'astro:content';
import BaseLayout from '@layouts/BaseLayout.astro';
import Section from '@components/Section.astro';
import PlaceholderTag from '@components/PlaceholderTag.astro';
import SystemPreview from '@components/SystemPreview.astro';
import Button from '@components/Button.astro';
import { SITE, EXPERTISE_AREAS } from '@lib/site';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => !data.draft);
  const sorted = projects.sort((a, b) => a.data.order - b.data.order);
  return sorted.map((project, i) => ({
    params: { slug: project.id },
    props: {
      project,
      prev: sorted[i - 1] ?? null,
      next: sorted[i + 1] ?? null,
      related: sorted.filter((_, j) => j !== i),
    },
  }));
}

const { project, prev, next, related } = Astro.props;
const { Content } = await render(project);
const {
  title,
  summary,
  year,
  client,
  role: myRole,
  placeholder,
  redacted,
  context,
  problem,
  approach,
  system,
  howItWorks,
  tools,
  implementation,
  outcome,
  evidenceNote,
  lessons,
  previewType,
  tags,
  coverImage,
} = project.data;

const coverExists = coverImage ? fs.existsSync(path.join(process.cwd(), 'public', coverImage)) : false;

// Data-driven, not a generic link: which of the five areas this system's
// own tags actually belong to (Phase 10 §25 — "use actual project
// tags/data, do not invent relationships").
const matchingAreas = EXPERTISE_AREAS.filter((area) => area.relatedTags.some((t) => tags.includes(t)));

const breadcrumbSchema = {
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: SITE.url },
    { '@type': 'ListItem', position: 2, name: 'Work', item: new URL('/projects', SITE.url).toString() },
    { '@type': 'ListItem', position: 3, name: title },
  ],
};

const outcomeLabel = outcome ? '07 — Outcome' : '07 — Current Evidence';
const outcomeValue = outcome ?? evidenceNote;

type Row =
  | { kind: 'text'; label: string; value: string | undefined }
  | { kind: 'system'; label: string };

const rows: Row[] = [
  { kind: 'text', label: '02 — Context', value: context },
  { kind: 'text', label: '03 — The Problem', value: problem },
  { kind: 'system', label: '04 — The System' },
  { kind: 'text', label: '05 — How It Works', value: howItWorks },
  { kind: 'text', label: '06 — Implementation', value: implementation },
  { kind: 'text', label: outcomeLabel, value: outcomeValue },
  { kind: 'text', label: '08 — Lessons', value: lessons },
];

// A generic, consistent evidence summary — not per-project bespoke prose —
// so every case study is judged by the same rule rather than one reading
// more "certain" than another due to wording alone.
const evidence = [
  {
    claim: 'That this system was designed and built by Milad',
    status: 'CONFIRMED',
    note: 'Stated directly by Milad, independent of any single file.',
  },
  {
    claim: 'The system description above (what it does, how it works)',
    status: 'SUPPORTED',
    note: 'Consistent with real project files reviewed; not independently verified by a third party.',
  },
  {
    claim: outcome ? 'The stated outcome' : 'A measurable outcome',
    status: outcome ? 'CONFIRMED' : 'NEEDS VERIFICATION',
    note: outcome
      ? 'Stated as a specific, evidenced result.'
      : 'No before/after metric exists yet for this system — shown as "current evidence" above rather than implied.',
  },
];
---

<BaseLayout
  title={title}
  description={summary}
  image={coverExists ? coverImage : undefined}
  type="article"
  structuredData={breadcrumbSchema}
>
  <Section>
    <div class="grid gap-8 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-8">
        <div class="flex flex-wrap items-center gap-3">
          <p class="font-mono text-[11px] text-meta uppercase tracking-wide">
            {myRole}{client && ` at ${client}`}
            {year && <span> · {year}</span>}
          </p>
          {placeholder && <PlaceholderTag />}
        </div>
        <h1 class="mt-2 max-w-3xl font-display text-3xl font-bold tracking-[-0.03em] text-ink sm:text-4xl">{title}</h1>
        <p class="mt-4 max-w-2xl font-body text-lg text-body">{summary}</p>

        {redacted && (
          <div class="mt-6 max-w-2xl border border-accent/30 bg-accent-tint px-4 py-3 font-body text-sm text-accent-ink">
            <strong class="font-semibold">10 — Limitations / Confidentiality.</strong> This
            write-up uses a recreated, redacted description rather than the real internal
            documents — some details are withheld to protect confidential company information.
          </div>
        )}
      </div>
      <div class="hidden items-start justify-end lg:col-span-4 lg:flex">
        <SystemPreview type={previewType ?? 'dashboard'} class="text-line" />
      </div>
    </div>

    <div class="mt-12 space-y-10 border-t border-line pt-10">
      {rows.map((row) => {
        if (row.kind === 'system') {
          if (!approach && !system) return null;
          return (
            <div class="grid gap-3 sm:grid-cols-12 sm:gap-8">
              <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase sm:col-span-3">
                {row.label}
              </h2>
              <div class="max-w-2xl space-y-3 sm:col-span-9">
                {approach && (
                  <p class="font-body text-base text-body">
                    <span class="font-semibold text-ink">Approach — </span>
                    {approach}
                  </p>
                )}
                {system && (
                  <p class="font-body text-base text-body">
                    <span class="font-semibold text-ink">What was built — </span>
                    {system}
                  </p>
                )}
              </div>
            </div>
          );
        }
        if (!row.value) return null;
        return (
          <div class="grid gap-2 sm:grid-cols-12 sm:gap-8">
            <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase sm:col-span-3">
              {row.label}
            </h2>
            <p class="max-w-2xl font-body text-base text-body sm:col-span-9">{row.value}</p>
          </div>
        );
      })}

      {tools.length > 0 && (
        <div class="grid gap-2 sm:grid-cols-12 sm:gap-8">
          <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase sm:col-span-3">
            06a — Tools
          </h2>
          <ul class="flex flex-wrap gap-2 sm:col-span-9">
            {tools.map((tool) => (
              <li class="border border-line px-3 py-1 font-mono text-[10px] tracking-wide text-body uppercase">
                {tool}
              </li>
            ))}
          </ul>
        </div>
      )}

      <div class="grid gap-3 sm:grid-cols-12 sm:gap-8">
        <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase sm:col-span-3">
          09 — Evidence
        </h2>
        <dl class="space-y-3 sm:col-span-9">
          {evidence.map((item) => (
            <div class="flex flex-col gap-1 sm:flex-row sm:items-baseline sm:gap-4">
              <dt
                class:list={[
                  'shrink-0 font-mono text-[10px] font-bold tracking-wide uppercase',
                  item.status === 'CONFIRMED' ? 'text-accent-ink' : 'text-meta',
                ]}
              >
                {item.status}
              </dt>
              <dd class="font-body text-base text-body">
                <span class="font-semibold text-ink">{item.claim}.</span> {item.note}
              </dd>
            </div>
          ))}
        </dl>
      </div>
    </div>

    <div class="prose mt-12 max-w-(--container-prose) border-t border-line pt-8 font-body text-sm text-meta">
      <Content />
    </div>

    {related.length > 0 && (
      <div class="mt-16 border-t border-line pt-10">
        <h2 class="font-mono text-[11px] font-bold tracking-[0.16em] text-accent-ink uppercase">
          11 — Related Systems
        </h2>
        <ul class="mt-4 flex flex-wrap gap-x-8 gap-y-2">
          {related
            .filter((r) => r.data.tags.some((t) => tags.includes(t)))
            .slice(0, 3)
            .map((r) => (
              <li>
                <a href={`/projects/${r.id}`} class="flex min-h-11 items-center font-body text-base text-body underline decoration-line underline-offset-4 hover:text-accent-ink hover:decoration-accent">
                  {r.data.title}
                </a>
              </li>
            ))}
        </ul>
      </div>
    )}

    <div class="mt-10 flex flex-wrap gap-3 border-t border-line pt-8">
      <Button href="/expertise#matrix" variant="secondary" arrow data-cta="project-related-expertise">
        {matchingAreas.length === 1 ? `See related expertise: ${matchingAreas[0].title}` : 'See related expertise'}
      </Button>
      <Button href="/contents/articles" variant="ghost" arrow data-cta="project-read-writing">Read the writing</Button>
    </div>

    <nav aria-label="Case study navigation" class="mt-10 flex items-center justify-between border-t border-line pt-8">
      {prev ? (
        <Button href={`/projects/${prev.id}`} variant="ghost" class="-ml-5">← {prev.data.title}</Button>
      ) : <span />}
      {next ? (
        <Button href={`/projects/${next.id}`} variant="ghost" arrow>{next.data.title}</Button>
      ) : (
        <Button href="/projects" variant="ghost" arrow>All systems</Button>
      )}
    </nav>
  </Section>
</BaseLayout>
