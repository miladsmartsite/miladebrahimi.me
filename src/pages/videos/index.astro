---
/**
 * /videos: Shorts and long videos straight from the YouTube channel feed,
 * refreshed by the hourly scheduled build. Replaces the separate PHP
 * videos page that was prepared in ME Studio (dist/videos-page.zip).
 */
import BaseLayout from '@layouts/BaseLayout.astro';
import PageHero from '@components/PageHero.astro';
import Section from '@components/Section.astro';
import Button from '@components/Button.astro';
import VideoCard from '@components/VideoCard.astro';
import { getVideos } from '@lib/youtube';
import { SITE, YOUTUBE } from '@lib/site';

const videos = await getVideos();
const shorts = videos.filter((v) => v.short);
const long = videos.filter((v) => !v.short);

const listSchema =
  videos.length > 0
    ? {
        '@type': 'ItemList',
        itemListElement: videos.map((v, i) => ({
          '@type': 'ListItem',
          position: i + 1,
          item: {
            '@type': 'VideoObject',
            name: v.title,
            description: v.description || v.title,
            thumbnailUrl: v.thumbnail,
            uploadDate: v.published.toISOString(),
            embedUrl: `https://www.youtube.com/embed/${v.id}`,
            url: v.url,
            author: { '@id': `${SITE.url}/#person` },
          },
        })),
      }
    : undefined;
---

<BaseLayout
  title="Videos"
  description="One practical idea a day from Milad Ebrahimi's books, in under 30 seconds: time engineering, self-coaching, goals, focus and balance. Plus a longer video every Saturday."
  structuredData={listSchema}
>
  <PageHero
    kicker={YOUTUBE.series}
    title="One idea a day to *lead yourself.*"
    subtitle="Short, practical tools from my books: goals, balance, focus and the daily routine that makes change stick. A new Short every day, and a longer video every Saturday."
  >
    <div class="mt-9 flex flex-wrap gap-3">
      <Button href={YOUTUBE.subscribeUrl} external arrow data-cta="videos-subscribe">Subscribe on YouTube</Button>
      <Button href="/start/" variant="secondary" data-cta="videos-worksheet">Free Balance Wheel worksheet</Button>
    </div>
  </PageHero>

  {long.length > 0 && (
    <Section tone="dark" kicker="Long videos" heading="Saturday *deep dives.*" width="wide">
      <div class="grid gap-x-8 gap-y-12 md:grid-cols-2">
        {long.map((video) => <VideoCard video={video} source="videos-long" />)}
      </div>
    </Section>
  )}

  <Section tone="dark" kicker="Shorts" heading={shorts.length > 0 ? 'Latest *Shorts.*' : 'New Shorts every day.'} width="wide">
    {shorts.length > 0 ? (
      <div class="grid grid-cols-2 gap-x-4 gap-y-10 sm:grid-cols-3 sm:gap-x-6 lg:grid-cols-5">
        {shorts.map((video) => <VideoCard video={video} source="videos-short" />)}
      </div>
    ) : (
      <p class="max-w-xl text-lg text-on-dark-muted">The newest videos appear here automatically. Until then, watch them on the channel.</p>
    )}
    <div class="mt-14 flex flex-wrap items-center gap-x-6 gap-y-3 border-t border-on-dark-line pt-8">
      <Button href={YOUTUBE.url} external variant="secondary" arrow data-cta="videos-channel">Everything on the channel</Button>
      <p class="text-sm text-on-dark-muted">The newest 15 uploads are listed here. Videos are hosted on YouTube.</p>
    </div>
  </Section>
</BaseLayout>
