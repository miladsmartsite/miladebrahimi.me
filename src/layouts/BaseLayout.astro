---
import '@styles/global.css';
import SEO from '@components/SEO.astro';
import Analytics from '@components/Analytics.astro';
import Header from '@components/Header.astro';
import Footer from '@components/Footer.astro';
import { SITE, SOCIAL_LINKS, PERSON_ID } from '@lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Focused landing page: header without navigation (used by /start). */
  minimal?: boolean;
  /** Extra JSON-LD (Article/Book/BreadcrumbList/etc.), one object or several. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type, noindex, minimal = false, structuredData } = Astro.props;

// Person schema: every field is structural or confirmed (bio-facts ✅).
const personSchema = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.jobTitle,
  description: SITE.positioning,
  image: new URL('/images/profile/milad-portrait.jpg', SITE.url).toString(),
  homeLocation: { '@type': 'Place', name: 'Muscat, Oman' },
  sameAs: SOCIAL_LINKS.map((link) => link.href),
};

const websiteSchema = {
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  author: { '@id': PERSON_ID },
};

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    websiteSchema,
    ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline>document.documentElement.classList.add('js');</script>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#141414" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} · Ideas`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <Analytics />

    <link rel="preload" as="font" type="font/woff2" href="/fonts/manrope/manrope-latin-800-normal.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/inter/inter-latin-400-normal.woff2" crossorigin />
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:z-50 focus:bg-accent focus:px-4 focus:py-3 focus:font-semibold focus:text-ink"
    >
      Skip to content
    </a>
    <Header minimal={minimal} />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal. Content is visible by default; this only adds a small
      // settle as a section enters the viewport. No observer = no effect.
      const items = document.querySelectorAll('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.08, rootMargin: '0px 0px -6% 0px' },
        );
        items.forEach((el) => {
          // Anything already on screen at load is shown at once.
          if (el.getBoundingClientRect().top < window.innerHeight) el.classList.add('is-revealed');
          else observer.observe(el);
        });
      } else {
        items.forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
