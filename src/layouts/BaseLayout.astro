---
import '@styles/global.css';
import SEO from '@components/SEO.astro';
import Analytics from '@components/Analytics.astro';
import Nav from '@components/Nav.astro';
import MobileNavToggle from '@components/MobileNavToggle.astro';
import MobileNavPanel from '@components/MobileNavPanel.astro';
import Footer from '@components/Footer.astro';
import { SITE, SOCIAL_LINKS, PERSON_ID } from '@lib/site';

interface Props {
  title: string;
  description?: string;
  image?: string;
  type?: 'website' | 'article';
  noindex?: boolean;
  /** Extra JSON-LD (Article/Book/BreadcrumbList/etc.) for pages beyond the
   * sitewide Person + WebSite graph — one object, or several. */
  structuredData?: Record<string, unknown> | Record<string, unknown>[];
}

const { title, description, image, type, noindex, structuredData } = Astro.props;

// Person schema — every field here is either structural (name/url) or
// CV-verbatim/confirmed (jobTitle, description, image, sameAs). No claimed
// employer, awards, or credentials are asserted; sameAs is populated only
// from real profile URLs already published elsewhere on the site.
const personSchema = {
  '@type': 'Person',
  '@id': PERSON_ID,
  name: SITE.name,
  url: SITE.url,
  jobTitle: SITE.jobTitle,
  description: SITE.positioning,
  image: new URL('/images/profile/milad-portrait.jpg', SITE.url).toString(),
  ...(SOCIAL_LINKS.length > 0 ? { sameAs: SOCIAL_LINKS.map((link) => link.href) } : {}),
};

// WebSite schema — the site as a whole, kept minimal and accurate. No
// SearchAction: the site has no internal search to describe. `author`
// references the same Person node above (via `@id`), not a duplicate —
// this is the one entity the whole site is written by and about.
const websiteSchema = {
  '@type': 'WebSite',
  name: SITE.name,
  url: SITE.url,
  author: { '@id': PERSON_ID },
};

// One `@graph` per page — Person and WebSite are sitewide; a page can add
// its own Article/Book/BreadcrumbList alongside them via `structuredData`.
// Per-page entries pass in without their own `@context` (this wrapper
// supplies the one shared context for everything in the graph).
const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    personSchema,
    websiteSchema,
    ...(structuredData ? (Array.isArray(structuredData) ? structuredData : [structuredData]) : []),
  ],
};
---

<!doctype html>
<html lang={SITE.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — Ideas`} href="/rss.xml" />
    <meta name="generator" content={Astro.generator} />
    <SEO title={title} description={description} image={image} type={type} noindex={noindex} />
    <script type="application/ld+json" is:inline set:html={JSON.stringify(jsonLd)} />
    <Analytics />

    <!-- Preload the two fonts used above the fold on every page. -->
    <link rel="preload" as="font" type="font/woff2" href="/fonts/bricolage-grotesque/bricolage-grotesque-variable.woff2" crossorigin />
    <link rel="preload" as="font" type="font/woff2" href="/fonts/crimson-pro/crimson-pro-variable.woff2" crossorigin />

    <noscript>
      <style>
        [data-reveal] {
          opacity: 1 !important;
          transform: none !important;
        }
      </style>
    </noscript>
  </head>
  <body class="flex min-h-screen flex-col">
    <a
      href="#main-content"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:bg-ink-0 focus:px-4 focus:py-2 focus:text-ink-950"
    >
      Skip to content
    </a>
    <Nav />
    <MobileNavToggle />
    <MobileNavPanel />
    <main id="main-content" class="flex-1">
      <slot />
    </main>
    <Footer />

    <script>
      // Scroll-reveal: promote [data-reveal] elements to their resting
      // state once they enter the viewport. If IntersectionObserver is
      // unavailable, reveal everything immediately rather than hide content.
      if ('IntersectionObserver' in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-revealed');
                observer.unobserve(entry.target);
              }
            }
          },
          { threshold: 0.1, rootMargin: '0px 0px -8% 0px' },
        );
        document.querySelectorAll('[data-reveal]').forEach((el) => observer.observe(el));
      } else {
        document.querySelectorAll('[data-reveal]').forEach((el) => el.classList.add('is-revealed'));
      }
    </script>
  </body>
</html>
